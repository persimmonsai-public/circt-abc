/* Hermetic test liberty for register_mapper_multibit.mlir: a plain flop, an
   async-clear flop and an async-preset flop (active-low). The multibit cells
   the spec names (register_mapper_multibit.json) are invented and need no
   liberty entry: the pass declares them as extern modules. */
library(mb_test_cells) {
  cell(TDFF) {
    area : 0.18 ;
    ff(IQ, IQN) { clocked_on : "CK" ; next_state : "D" ; }
    pin(CK) { direction : input ; clock : true ; }
    pin(D) { direction : input ; nextstate_type : data ; }
    pin(Q) { direction : output ; function : "IQ" ; }
  }
  cell(TDFFR) {
    area : 0.20 ;
    ff(IQ, IQN) { clocked_on : "CK" ; next_state : "D" ; clear : "R" ; }
    pin(CK) { direction : input ; clock : true ; }
    pin(D) { direction : input ; nextstate_type : data ; }
    pin(R) { direction : input ; }
    pin(Q) { direction : output ; function : "IQ" ; }
  }
  cell(TDFFS) {
    area : 0.20 ;
    ff(IQ, IQN) { clocked_on : "CK" ; next_state : "D" ; preset : "!SN" ; }
    pin(CK) { direction : input ; clock : true ; }
    pin(D) { direction : input ; nextstate_type : data ; }
    pin(SN) { direction : input ; }
    pin(Q) { direction : output ; function : "IQ" ; }
  }
}
