From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eugene Feinberg <uge@persimmons.ai>
Date: Tue, 6 Oct 2026 10:20:14 -0700
Subject: [PATCH 36/37] [ImportVerilog] Test run-time element order of nested
 unpacked-array parameters

The constant-only check could not tell index orders apart (slang evaluates
the function at elaboration). Read the parameter with run-time indices and
check the materialized array keeps SystemVerilog's element order.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../param-nested-unpacked-array.sv              | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/test/Conversion/ImportVerilog/param-nested-unpacked-array.sv b/test/Conversion/ImportVerilog/param-nested-unpacked-array.sv
index 74ced1509..0716f8dcf 100644
--- a/test/Conversion/ImportVerilog/param-nested-unpacked-array.sv
+++ b/test/Conversion/ImportVerilog/param-nested-unpacked-array.sv
@@ -30,3 +30,20 @@ endmodule
 module Top (output logic [7:0] m);
   Lut #(.N(2), .Map('{'{32'd2, 32'd3}, '{32'd5, 32'd1}})) u (.m(m));
 endmodule
+
+// Read at run time, the materialized constant must keep SystemVerilog's
+// element order: the left index of [1:0] is 1, so Map[1] = '{2,3} and
+// Map[0] = '{5,1}; the inner [0:1] makes Map[x][0] the leftmost element.
+// (hw.array_create and hw.aggregate_constant list the highest index first.)
+// HW-LABEL: hw.module @RuntimeRead(
+// HW-DAG: [[HI:%.+]] = hw.aggregate_constant [2 : i32, 3 : i32] : !hw.array<2xi32>
+// HW-DAG: [[LO:%.+]] = hw.aggregate_constant [5 : i32, 1 : i32] : !hw.array<2xi32>
+// HW: [[MAP:%.+]] = hw.array_create [[HI]], [[LO]] : !hw.array<2xi32>
+// HW: [[ROW:%.+]] = hw.array_get [[MAP]][%sel]
+// HW: [[COL:%.+]] = comb.sub %true, %k : i1
+// HW: hw.array_get [[ROW]][[[COL]]]
+module RuntimeRead #(
+  parameter int unsigned Map [1:0][0:1] = '{'{32'd2, 32'd3}, '{32'd5, 32'd1}}
+) (input logic sel, input logic k, output logic [31:0] o);
+  assign o = Map[sel][k];
+endmodule
