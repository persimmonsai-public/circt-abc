From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eugene Feinberg <uge@persimmons.ai>
Date: Sat, 29 Aug 2026 18:26:47 -0700
Subject: [PATCH 14/37] LLHD UnrollLoops: eliminate trivially loop-invariant
 header phis

A header block argument that receives the same value V on every entry edge
and itself (or V) from the latch is just V. store_buffer's speculative-queue
search loop carries its loop-invariant page offset that way and reads it in
the join block, which tripped the multi-exit outside-use check even though
nothing iteration-dependent escapes.

Replacing the arg with V is sound wherever the arg was usable: MLIR verified
every existing use as dominated by the header, and a V that reaches the
header on every path dominates everything the header dominates. Only values
defined entirely outside the loop body are accepted, which sidesteps
dominance analysis.

Clears store_buffer completely (0 llhd, 8 registers). Reproducers and ibex
unchanged.
---
 lib/Dialect/LLHD/Transforms/UnrollLoops.cpp | 42 +++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/lib/Dialect/LLHD/Transforms/UnrollLoops.cpp b/lib/Dialect/LLHD/Transforms/UnrollLoops.cpp
index 46100282d..a20189b7a 100644
--- a/lib/Dialect/LLHD/Transforms/UnrollLoops.cpp
+++ b/lib/Dialect/LLHD/Transforms/UnrollLoops.cpp
@@ -248,6 +248,48 @@ bool Loop::match() {
       }
     }
 
+    // Eliminate trivially loop-invariant header phis before checking for
+    // outside uses. A header block argument that receives the same value V
+    // on every entry edge and itself (or V) from the latch is just V --
+    // store_buffer carries its loop-invariant page offset that way and then
+    // reads it in the join block, which would otherwise trip the outside-use
+    // check below even though nothing iteration-dependent escapes. Replacing
+    // the arg with V is sound wherever the arg was usable: MLIR verified
+    // every existing use as dominated by the header, and a V that reaches
+    // the header on every path dominates everything the header dominates.
+    // Only values defined outside this region's loop blocks entirely are
+    // accepted, sidestepping the need for dominance analysis here.
+    auto *headerBlock = cfgLoop.getHeader();
+    for (auto arg : headerBlock->getArguments()) {
+      Value common;
+      bool trivial = true;
+      for (auto &use : headerBlock->getUses()) {
+        auto branchOp = dyn_cast<BranchOpInterface>(use.getOwner());
+        if (!branchOp) {
+          trivial = false;
+          break;
+        }
+        Value incoming = branchOp.getSuccessorOperands(
+            use.getOperandNumber())[arg.getArgNumber()];
+        if (incoming == arg)
+          continue;
+        if (common && incoming != common) {
+          trivial = false;
+          break;
+        }
+        common = incoming;
+      }
+      if (!trivial || !common)
+        continue;
+      if (auto *defOp = common.getDefiningOp())
+        if (bodySet.contains(defOp->getBlock()))
+          continue;
+      if (auto barg = dyn_cast<BlockArgument>(common))
+        if (bodySet.contains(barg.getOwner()))
+          continue;
+      arg.replaceAllUsesWith(common);
+    }
+
     for (auto *block : bodyList) {
       auto checkUsers = [&](Value value) {
         for (auto *user : value.getUsers())
