From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eugene Feinberg <uge@persimmons.ai>
Date: Tue, 1 Sep 2026 13:32:32 -0700
Subject: [PATCH 25/37] [LLHD] Sig2Reg: split coalesced multi-element array
 ranges per element

The narrowed-array interval path assumed each write covers one element;
a coalesced range spanning N elements emitted a single interval whose
value was element-typed, producing an illegal iK->iN*K bitcast
(ariane_regfile_ff: bitcast i32 -> i1024). Split such writes back into
per-element intervals via hw.array_get, mirroring the struct hull
splitting.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 lib/Dialect/LLHD/Transforms/Sig2RegPass.cpp | 28 +++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/lib/Dialect/LLHD/Transforms/Sig2RegPass.cpp b/lib/Dialect/LLHD/Transforms/Sig2RegPass.cpp
index 96f4b4a21..228f0e3d3 100644
--- a/lib/Dialect/LLHD/Transforms/Sig2RegPass.cpp
+++ b/lib/Dialect/LLHD/Transforms/Sig2RegPass.cpp
@@ -718,6 +718,34 @@ public:
                               b, driveOp.getLoc(), driveOp.getValue(),
                               fieldNames[writeIdx]);
                         } else if (isArray) {
+                          // coalesceRanges may have merged ADJACENT element
+                          // writes into one multi-element range; a single
+                          // array_get only covers elemBw of it, and the
+                          // reconstruction would bitcast that one element to
+                          // the full range width (i32 -> i1024 on a fully
+                          // written 32x32 regfile -- an invalid op). Mirror
+                          // the struct path's boundary splitting: emit one
+                          // interval per element of the range. The single-
+                          // element case falls through to the shared
+                          // emplace_back below unchanged.
+                          if (write.bitwidth > (uint64_t)elemBw) {
+                            for (uint64_t off = write.bitOffset;
+                                 off < write.bitOffset + write.bitwidth;
+                                 off += elemBw) {
+                              Value idx = hw::ConstantOp::create(
+                                  b, driveOp.getLoc(),
+                                  APInt(llvm::Log2_64_Ceil(
+                                            arrayTy.getNumElements()),
+                                        off / elemBw));
+                              Value subElem = hw::ArrayGetOp::create(
+                                  b, driveOp.getLoc(), driveOp.getValue(),
+                                  idx);
+                              intervals.emplace_back(
+                                  Offset(off), (uint64_t)elemBw, subElem,
+                                  curr->getBlock(), timeOp.getValueAttr());
+                            }
+                            continue;
+                          }
                           uint64_t index = write.bitOffset / elemBw;
                           Value idx = hw::ConstantOp::create(
                               b, driveOp.getLoc(),
