From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eugene Feinberg <uge@persimmons.ai>
Date: Tue, 6 Oct 2026 09:33:04 -0700
Subject: [PATCH 31/37] [CombToSynth] Lower zero-width comb.mux to a constant

A zero-width mux reached the MuxOp lowering, which replicates the i1
condition to the operand width; comb.replicate cannot produce i0, so
convert-comb-to-synth failed ('replicate cannot shrink bitwidth of
operand'). A zero-width value has a single value, so lower the mux to
hw.constant 0 : i0 (bitcast for zero-width aggregates).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/Conversion/CombToSynth/CombToSynth.cpp   | 11 +++++++++++
 test/Conversion/CombToSynth/comb-to-aig.mlir | 11 +++++++++++
 2 files changed, 22 insertions(+)

diff --git a/lib/Conversion/CombToSynth/CombToSynth.cpp b/lib/Conversion/CombToSynth/CombToSynth.cpp
index dd28f071e..3d4c4759f 100644
--- a/lib/Conversion/CombToSynth/CombToSynth.cpp
+++ b/lib/Conversion/CombToSynth/CombToSynth.cpp
@@ -433,6 +433,17 @@ struct CombMuxOpToSynthConversion : OpConversionPattern<MuxOp> {
     Value trueVal = adaptor.getTrueValue();
     Value falseVal = adaptor.getFalseValue();
 
+    // A zero-width value has exactly one value: the mux is that constant.
+    // (Replicating the i1 condition to i0 below would be invalid.)
+    if (hw::getBitWidth(op.getType()) == 0) {
+      Value zero = hw::ConstantOp::create(rewriter, op.getLoc(),
+                                         APInt(/*numBits=*/0u, /*val=*/0ull));
+      if (zero.getType() != op.getType())
+        zero = hw::BitcastOp::create(rewriter, op.getLoc(), op.getType(), zero);
+      replaceOpAndCopyNamehint(rewriter, op, zero);
+      return success();
+    }
+
     if (!op.getType().isInteger()) {
       auto widthType = rewriter.getIntegerType(hw::getBitWidth(op.getType()));
       trueVal =
diff --git a/test/Conversion/CombToSynth/comb-to-aig.mlir b/test/Conversion/CombToSynth/comb-to-aig.mlir
index 0b1745422..fc25207d9 100644
--- a/test/Conversion/CombToSynth/comb-to-aig.mlir
+++ b/test/Conversion/CombToSynth/comb-to-aig.mlir
@@ -64,6 +64,17 @@ hw.module @mux(in %cond: i1, in %high: !hw.array<2xi4>, in %low: !hw.array<2xi4>
   hw.output %0 : !hw.array<2xi4>
 }
 
+// A zero-width mux has a single possible value; it lowers to a constant
+// instead of replicating the condition to i0.
+// CHECK-LABEL: @mux_zero_width
+// CHECK-NOT: comb.replicate
+// CHECK-NOT: comb.mux
+// CHECK: hw.constant 0 : i0
+hw.module @mux_zero_width(in %cond: i1, in %a: i0, in %b: i0, out out: i0) {
+  %0 = comb.mux %cond, %a, %b : i0
+  hw.output %0 : i0
+}
+
 // CHECK-LABEL: func.func @parity
 func.func @parity(%arg0: i4) -> i1 {
   // CHECK-NOT: comb.parity
-- 
