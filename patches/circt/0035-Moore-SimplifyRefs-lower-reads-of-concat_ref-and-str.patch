 lib/Dialect/Moore/Transforms/SimplifyRefs.cpp | 95 +++++++++++++++++++
 .../ref-concat-read-and-struct-partselect.sv  | 36 +++++++
 .../struct-partselect-nonblocking.sv          | 19 ++++
 3 files changed, 150 insertions(+)
 create mode 100644 test/Conversion/ImportVerilog/ref-concat-read-and-struct-partselect.sv
 create mode 100644 test/Conversion/ImportVerilog/struct-partselect-nonblocking.sv

diff --git a/lib/Dialect/Moore/Transforms/SimplifyRefs.cpp b/lib/Dialect/Moore/Transforms/SimplifyRefs.cpp
index 29aa4fdf9..a799f4e43 100644
--- a/lib/Dialect/Moore/Transforms/SimplifyRefs.cpp
+++ b/lib/Dialect/Moore/Transforms/SimplifyRefs.cpp
@@ -295,8 +295,103 @@ std::unique_ptr<mlir::Pass> circt::moore::createSimplifyRefsPass() {
   return std::make_unique<SimplifyRefsPass>();
 }
 
+/// The value read through `ref`: a read, or for a concatenation of
+/// references the concatenation of the reads of its parts.
+static Value readThrough(OpBuilder &builder, Location loc, Value ref) {
+  if (auto concat = ref.getDefiningOp<ConcatRefOp>()) {
+    SmallVector<Value> parts;
+    for (auto part : concat.getValues())
+      parts.push_back(readThrough(builder, loc, part));
+    return ConcatOp::create(builder, loc, parts);
+  }
+  return ReadOp::create(builder, loc, ref);
+}
+
+/// Reading a concatenation of references (a compound assignment to a
+/// concatenation, `{a, b} &= e`, reads its left-hand side back) is the
+/// concatenation of the reads. Rewrite those reads first, so the assignments
+/// below see `concat_ref` only as their destination.
+static void lowerReadsOfConcatRefs(Operation *root) {
+  SmallVector<ReadOp> reads;
+  root->walk([&](ReadOp read) {
+    if (read.getInput().getDefiningOp<ConcatRefOp>())
+      reads.push_back(read);
+  });
+  for (auto read : reads) {
+    OpBuilder builder(read);
+    read.replaceAllUsesWith(
+        readThrough(builder, read.getLoc(), read.getInput()));
+    read.erase();
+  }
+}
+
+/// A dynamic part-select of a packed struct reference (`s[i*W +: W]`, legal
+/// on any packed type) has no LLHD signal projection. Rewrite its reads as a
+/// dyn_extract of the struct's bit vector, and its blocking assignments as a
+/// read-modify-write of the whole struct through that bit vector.
+///
+/// Only blocking assignments: a read-modify-write of a non-blocking
+/// assignment would read the struct's current value, so of two non-blocking
+/// part-selects in one block the second would undo the first. Those (and any
+/// other use) are left alone and still fail to legalize.
+static void lowerDynExtractRefsOfStructs(Operation *root) {
+  SmallVector<DynExtractRefOp> refs;
+  root->walk([&](DynExtractRefOp op) {
+    if (isa<StructType>(cast<RefType>(op.getInput().getType()).getNestedType()))
+      refs.push_back(op);
+  });
+  for (auto ref : refs) {
+    Value whole = ref.getInput();
+    auto structTy =
+        cast<PackedType>(cast<RefType>(whole.getType()).getNestedType());
+    auto sbvTy = dyn_cast_or_null<IntType>(structTy.getSimpleBitVector());
+    auto partTy =
+        dyn_cast<IntType>(cast<RefType>(ref.getType()).getNestedType());
+    if (!sbvTy || !partTy || partTy.getDomain() != sbvTy.getDomain() ||
+        partTy.getWidth() > sbvTy.getWidth())
+      continue;
+    unsigned n = sbvTy.getWidth(), w = partTy.getWidth();
+    for (Operation *user : llvm::make_early_inc_range(ref->getUsers())) {
+      OpBuilder b(user);
+      Location loc = user->getLoc();
+      auto bits = [&]() -> Value {
+        Value v = ReadOp::create(b, loc, whole);
+        return PackedToSBVOp::create(b, loc, v);
+      };
+      if (auto read = dyn_cast<ReadOp>(user)) {
+        Value part =
+            DynExtractOp::create(b, loc, partTy, bits(), ref.getLowBit());
+        read.replaceAllUsesWith(part);
+        read.erase();
+        continue;
+      }
+      auto assign = dyn_cast<BlockingAssignOp>(user);
+      if (!assign || assign.getDst() != ref.getResult() ||
+          assign.getSrc().getType() != partTy)
+        continue;
+      Value old = bits();
+      Value mask =
+          ConstantOp::create(b, loc, sbvTy, FVInt(APInt::getLowBitsSet(n, w)));
+      Value amount = ref.getLowBit();
+      Value hole = NotOp::create(b, loc, ShlOp::create(b, loc, mask, amount));
+      Value src = assign.getSrc();
+      Value wide =
+          w == n ? src : ZExtOp::create(b, loc, sbvTy, src).getResult();
+      Value merged = OrOp::create(b, loc, AndOp::create(b, loc, old, hole),
+                                  ShlOp::create(b, loc, wide, amount));
+      assign.getDstMutable().assign(whole);
+      assign.getSrcMutable().assign(
+          SBVToPackedOp::create(b, loc, structTy, merged));
+    }
+    if (ref->use_empty())
+      ref.erase();
+  }
+}
+
 void SimplifyRefsPass::runOnOperation() {
   MLIRContext &context = getContext();
+  lowerReadsOfConcatRefs(getOperation());
+  lowerDynExtractRefsOfStructs(getOperation());
   ConversionTarget target(context);
 
   target.addDynamicallyLegalOp<ContinuousAssignOp, BlockingAssignOp,
diff --git a/test/Conversion/ImportVerilog/ref-concat-read-and-struct-partselect.sv b/test/Conversion/ImportVerilog/ref-concat-read-and-struct-partselect.sv
new file mode 100644
index 000000000..f449c4232
--- /dev/null
+++ b/test/Conversion/ImportVerilog/ref-concat-read-and-struct-partselect.sv
@@ -0,0 +1,36 @@
+// RUN: circt-verilog --ir-hw %s | FileCheck %s
+// REQUIRES: slang
+
+// A compound assignment to a concatenation reads the concatenation back:
+// `{x, y} &= m` used to leave a moore.concat_ref that MooreToCore could not
+// legalize.
+// CHECK-LABEL: hw.module @CompoundConcat(
+// CHECK-DAG: [[LOW:%.+]] = comb.extract %b from 0 : (i10) -> i2
+// CHECK-DAG: [[Y:%.+]] = comb.concat %c0_i8, [[LOW]] : i8, i2
+// CHECK: hw.output %c0_i10, [[Y]] : i10, i10
+module CompoundConcat(input logic [9:0] a, b, output logic [9:0] x, y);
+  always_comb begin
+    x = a; y = b;
+    {x, y} &= 20'h3;
+  end
+endmodule
+
+// A dynamic part-select write into a packed struct (legal on any packed
+// type) used to leave a moore.dyn_extract_ref on a struct reference.
+// CHECK-LABEL: hw.module @StructPartSelect(
+// CHECK-DAG: [[D0:%.+]] = hw.array_get %d[%false]
+// CHECK-DAG: [[D1:%.+]] = hw.array_get %d[%true]
+// CHECK-DAG: comb.concat [[D0]], %c0_i128 : i64, i128
+// CHECK-DAG: comb.concat %c0_i64, [[D1]], %c0_i64 : i64, i64, i64
+// CHECK: hw.struct_inject {{%.+}}["c"], %last
+module StructPartSelect(input logic [1:0][63:0] d, input logic [63:0] last, output logic [191:0] o);
+  typedef struct packed { logic [63:0] a; logic [63:0] b; logic [63:0] c; } desc_t;
+  desc_t cur;
+  always_comb begin
+    cur = '0;
+    for (int i = 0; i < 2; i++)
+      cur[191 - i*64 -: 64] = d[i];
+    cur[63:0] = last;
+  end
+  assign o = cur;
+endmodule
diff --git a/test/Conversion/ImportVerilog/struct-partselect-nonblocking.sv b/test/Conversion/ImportVerilog/struct-partselect-nonblocking.sv
new file mode 100644
index 000000000..f56db4bdf
--- /dev/null
+++ b/test/Conversion/ImportVerilog/struct-partselect-nonblocking.sv
@@ -0,0 +1,19 @@
+// RUN: not circt-verilog --ir-hw %s 2>&1 | FileCheck %s
+// REQUIRES: slang
+
+// A dynamic part-select write into a packed struct is lowered as a
+// read-modify-write of the whole struct only for blocking assignments. For
+// non-blocking ones that would read the struct's current value, so of the
+// two writes below the second would silently undo the first. They are left
+// unlowered and remain an error rather than being miscompiled.
+// CHECK: error: failed to legalize operation 'moore.dyn_extract_ref'
+module NonBlockingParts(input logic clk, input logic [1:0] i, j,
+                        input logic [7:0] a, b, output logic [31:0] o);
+  typedef struct packed { logic [15:0] hi; logic [15:0] lo; } s_t;
+  s_t s;
+  always_ff @(posedge clk) begin
+    s[i*8 +: 8] <= a;
+    s[j*8 +: 8] <= b;
+  end
+  assign o = s;
+endmodule
