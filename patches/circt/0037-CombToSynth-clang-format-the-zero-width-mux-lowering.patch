From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eugene Feinberg <uge@persimmons.ai>
Date: Tue, 6 Oct 2026 10:21:12 -0700
Subject: [PATCH 37/37] [CombToSynth] clang-format the zero-width mux lowering

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/Conversion/CombToSynth/CombToSynth.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/Conversion/CombToSynth/CombToSynth.cpp b/lib/Conversion/CombToSynth/CombToSynth.cpp
index 3d4c4759f..d45870bd6 100644
--- a/lib/Conversion/CombToSynth/CombToSynth.cpp
+++ b/lib/Conversion/CombToSynth/CombToSynth.cpp
@@ -437,7 +437,7 @@ struct CombMuxOpToSynthConversion : OpConversionPattern<MuxOp> {
     // (Replicating the i1 condition to i0 below would be invalid.)
     if (hw::getBitWidth(op.getType()) == 0) {
       Value zero = hw::ConstantOp::create(rewriter, op.getLoc(),
-                                         APInt(/*numBits=*/0u, /*val=*/0ull));
+                                          APInt(/*numBits=*/0u, /*val=*/0ull));
       if (zero.getType() != op.getType())
         zero = hw::BitcastOp::create(rewriter, op.getLoc(), op.getType(), zero);
       replaceOpAndCopyNamehint(rewriter, op, zero);
