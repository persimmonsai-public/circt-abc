+// PHYS-MAP-AIG.  A COVER-INVARIANT position estimate, computed from the AIG
+// alone -- the cheap analytic stand-in for LevelSyn's GNN (arXiv:2609.03594).
+//
+// Why not a real placement: a placement describes ONE netlist, and the mapper
+// then emits a different one, so measured coordinates stop applying (that
+// version was built and measured as a null result).  Positions
+// derived from the AIG are invariant across covers, which is exactly the
+// property the mapper needs and the reason the paper predicts rather than
+// measures.
+//
+//   x = Normalized Level Index, Level(v)/LevMax  (LevelSyn's NLI)
+//   y = barycenter smoothing over fanins+fanouts, PIs/POs spread as anchors
+//   cap(v) ~ HPWL of v's fanout star
+//
+// The result is scaled to PRESERVE the mean of the fanout-count model it
+// replaces, so this changes only the DISTRIBUTION of wire load, never the
+// total.  That isolates the hypothesis (the fanout model gets the mean about
+// right and the spread wrong: measured R^2 = 0.56 against a real placement)
+// and avoids inventing a die-size parameter.
+void Nf_ManAigPlace( Nf_Man_t * p, int nRounds )
+{
+    Gia_Man_t * pGia = p->pGia;
+    int nObj = Gia_ManObjNum(pGia);
+    Vec_Flt_t * vX = Vec_FltStart( nObj );
+    Vec_Flt_t * vY = Vec_FltStart( nObj );
+    Vec_Flt_t * vYn = Vec_FltStart( nObj );
+    Gia_Obj_t * pObj; int i, r, LevMax, nPi = Gia_ManPiNum(pGia), iPi = 0;
+    double SumH = 0, SumF = 0; int nUsed = 0;
+
+    LevMax = Gia_ManLevelNum( pGia );
+    if ( LevMax <= 0 ) LevMax = 1;
+    // x from the logic level; y seeded by PI order, then by fanin mean
+    Gia_ManForEachObj( pGia, pObj, i )
+    {
+        Vec_FltWriteEntry( vX, i, (float)Gia_ObjLevel(pGia, pObj) / LevMax );
+        if ( Gia_ObjIsPi(pGia, pObj) )
+            Vec_FltWriteEntry( vY, i, nPi > 1 ? (float)(iPi++) / (nPi - 1) : 0.5f );
+        else if ( Gia_ObjIsAnd(pObj) )
+            Vec_FltWriteEntry( vY, i, 0.5f * ( Vec_FltEntry(vY, Gia_ObjFaninId0(pObj, i))
+                                             + Vec_FltEntry(vY, Gia_ObjFaninId1(pObj, i)) ) );
+        else if ( Gia_ObjIsCo(pObj) )
+            Vec_FltWriteEntry( vY, i, Vec_FltEntry(vY, Gia_ObjFaninId0(pObj, i)) );
+    }
+    // barycenter smoothing over fanins and fanouts; PIs stay anchored
+    Gia_ManStaticFanoutStart( pGia );
+    for ( r = 0; r < nRounds; r++ )
+    {
+        Gia_ManForEachObj( pGia, pObj, i )
+        {
+            double Sum = 0; int nDeg = 0, iFan, k;
+            if ( Gia_ObjIsPi(pGia, pObj) ) { Vec_FltWriteEntry( vYn, i, Vec_FltEntry(vY, i) ); continue; }
+            if ( Gia_ObjIsAnd(pObj) )
+            {
+                Sum += Vec_FltEntry(vY, Gia_ObjFaninId0(pObj, i));
+                Sum += Vec_FltEntry(vY, Gia_ObjFaninId1(pObj, i));
+                nDeg += 2;
+            }
+            else if ( Gia_ObjIsCo(pObj) )
+            {
+                Sum += Vec_FltEntry(vY, Gia_ObjFaninId0(pObj, i));
+                nDeg++;
+            }
+            Gia_ObjForEachFanoutStaticId( pGia, i, iFan, k )
+            {
+                Sum += Vec_FltEntry(vY, iFan);
+                nDeg++;
+            }
+            Vec_FltWriteEntry( vYn, i, nDeg ? (float)(Sum / nDeg) : Vec_FltEntry(vY, i) );
+        }
+        ABC_SWAP( Vec_Flt_t *, vY, vYn );
+    }
+    // Calibrate ONE scalar: the mean normalised fanout-star HPWL is mapped onto
+    // AvgCapF, the library's own average input pin cap.  That fixes the UNIT of
+    // the wirelength term without needing a die size or an external wire-load
+    // model (a liberty may have no wire_load groups at all).
+    //
+    // The per-net wirelength itself is NOT computed here.  A node's AIG fanout
+    // is nearly unrelated to the fanout of the net it ends up driving --
+    // measured on this design, r = 0.067 (R^2 = 0.004) -- because mapping
+    // creates the nets.  Coordinates are cover-invariant; wirelength computed
+    // from them must not be, so it is accumulated per cover in
+    // Nf_ManComputeLoads over the current matches' cut leaves.
+    Gia_ManForEachAnd( pGia, pObj, i )
+    {
+        float xlo, xhi, ylo, yhi; int iFan, k, nFan = 0;
+        xlo = xhi = Vec_FltEntry(vX, i);
+        ylo = yhi = Vec_FltEntry(vY, i);
+        Gia_ObjForEachFanoutStaticId( pGia, i, iFan, k )
+        {
+            float x = Vec_FltEntry(vX, iFan), y = Vec_FltEntry(vY, iFan);
+            xlo = Abc_MinFloat(xlo, x); xhi = Abc_MaxFloat(xhi, x);
+            ylo = Abc_MinFloat(ylo, y); yhi = Abc_MaxFloat(yhi, y);
+            nFan++;
+        }
+        if ( nFan == 0 ) continue;
+        SumH += (xhi - xlo) + (yhi - ylo);
+        nUsed++;
+    }
+    Gia_ManStaticFanoutStop( pGia );
+    Vec_FltFreeP( &p->vPosX );
+    Vec_FltFreeP( &p->vPosY );
+    p->vPosX = vX; p->vPosY = vY;
+    p->PosScale = ( nUsed && SumH > 0 ) ? (float)(p->AvgCapF * nUsed / SumH) : 0;
+    printf( "PHYS-MAP-AIG: placed %d nodes, %d levels, %d rounds; scale %.4f fF per unit HPWL "
+            "(mean star HPWL %.4f -> AvgCap %.4f fF).\n",
+            nUsed, LevMax, nRounds, p->PosScale, SumH / Abc_MaxInt(nUsed,1), p->AvgCapF );
+    Vec_FltFree( vYn );
+    (void)SumF;
+}
+
+// PHYS-MAP.  The fanout-count wire-load model above explains only part of
+// real net HPWL: within the 2-pin class alone, measured nets span two orders
+// of magnitude.  When a placement of a previous mapping of
+// THIS SAME AIG is available, use its measured per-net cap for the node and
+// fall back to the fanout table only for nodes the placement does not cover.
+static inline float Nf_ManWireCapObj( Nf_Man_t * p, int iObj, int nFans )
+{
+    if ( p->vNodeWireCap && iObj >= 0 && iObj < Vec_FltSize(p->vNodeWireCap) )
+    {
+        float Cap = Vec_FltEntry( p->vNodeWireCap, iObj );
+        if ( Cap >= 0 )
+            return Cap;
+    }
+    return Nf_ManWireCap( p, nFans );
+}
 void Nf_ManComputeLoads( Nf_Man_t * p )
 {
     Gia_Obj_t * pObj; int i, c, k, iVar, fCompl, nUsed = 0;
     Vec_Int_t * vFans;
+    // PHYS-MAP-AIG: bounding box of each net's CONSUMERS under the current
+    // cover.  Cover-dependent by construction -- which is the whole point: the
+    // coordinates come from the AIG and never change, but which nodes share a
+    // net is decided by the mapping.
+    Vec_Flt_t * vBx0 = NULL, * vBx1 = NULL, * vBy0 = NULL, * vBy1 = NULL;
+    int fPos = ( p->vPosX && p->vPosY && p->PosScale > 0 );
     if ( !p->pPars->fUseLoads || p->fFreezeLoads )
         return;
     vFans = Vec_IntStart( Gia_ManObjNum(p->pGia) );
+    if ( fPos )
+    {
+        int n = Gia_ManObjNum(p->pGia);
+        vBx0 = Vec_FltStart(n); vBx1 = Vec_FltStart(n);
+        vBy0 = Vec_FltStart(n); vBy1 = Vec_FltStart(n);
+        Vec_FltFill( vBx0, n,  1.0e9 ); Vec_FltFill( vBx1, n, -1.0e9 );
+        Vec_FltFill( vBy0, n,  1.0e9 ); Vec_FltFill( vBy1, n, -1.0e9 );
+    }
     Vec_FltFill( &p->vLoads, Gia_ManObjNum(p->pGia), 0 );
     if ( p->Iter == 0 )
     {
@@ -1489,7 +1663,7 @@ void Nf_ManComputeLoads( Nf_Man_t * p )
         {
             float Refs = Vec_FltEntry(&p->vFlowRefs, 2*i) + Vec_FltEntry(&p->vFlowRefs, 2*i+1);
             int nFans = (int)(Refs + 0.5);
-            Vec_FltWriteEntry( &p->vLoads, i, Refs * p->AvgCapF + Nf_ManWireCap(p, nFans) );
+            Vec_FltWriteEntry( &p->vLoads, i, Refs * p->AvgCapF + Nf_ManWireCapObj(p, i, nFans) );
         }
     }
     else
@@ -1509,6 +1683,14 @@ void Nf_ManComputeLoads( Nf_Man_t * p )
             {
                 Vec_FltAddToEntry( &p->vLoads, iVar, (float)pCell->iCaps[k] / SCL_NUM );
                 Vec_IntAddToEntry( vFans, iVar, 1 );
+                if ( fPos )   // this match consumes iVar: extend iVar's net box
+                {
+                    float x = Vec_FltEntry(p->vPosX, i), y = Vec_FltEntry(p->vPosY, i);
+                    Vec_FltWriteEntry( vBx0, iVar, Abc_MinFloat(Vec_FltEntry(vBx0,iVar), x) );
+                    Vec_FltWriteEntry( vBx1, iVar, Abc_MaxFloat(Vec_FltEntry(vBx1,iVar), x) );
+                    Vec_FltWriteEntry( vBy0, iVar, Abc_MinFloat(Vec_FltEntry(vBy0,iVar), y) );
+                    Vec_FltWriteEntry( vBy1, iVar, Abc_MaxFloat(Vec_FltEntry(vBy1,iVar), y) );
+                }
             }
             nUsed++;
         }
@@ -1518,10 +1700,18 @@ void Nf_ManComputeLoads( Nf_Man_t * p )
             if ( nFans == 0 ) // node not referenced by the previous mapping: keep the flow estimate
             {
                 float Refs = Vec_FltEntry(&p->vFlowRefs, 2*i) + Vec_FltEntry(&p->vFlowRefs, 2*i+1);
-                Vec_FltWriteEntry( &p->vLoads, i, Refs * p->AvgCapF + Nf_ManWireCap(p, (int)(Refs + 0.5)) );
+                Vec_FltWriteEntry( &p->vLoads, i, Refs * p->AvgCapF + Nf_ManWireCapObj(p, i, (int)(Refs + 0.5)) );
+            }
+            else if ( fPos && Vec_FltEntry(vBx1, i) > -1.0e8 )
+            {
+                // net box = the driver's own position plus every consumer's
+                float x = Vec_FltEntry(p->vPosX, i), y = Vec_FltEntry(p->vPosY, i);
+                float h = ( Abc_MaxFloat(Vec_FltEntry(vBx1,i), x) - Abc_MinFloat(Vec_FltEntry(vBx0,i), x) )
+                        + ( Abc_MaxFloat(Vec_FltEntry(vBy1,i), y) - Abc_MinFloat(Vec_FltEntry(vBy0,i), y) );
+                Vec_FltAddToEntry( &p->vLoads, i, h * p->PosScale );
             }
             else
-                Vec_FltAddToEntry( &p->vLoads, i, Nf_ManWireCap(p, nFans) );
+                Vec_FltAddToEntry( &p->vLoads, i, Nf_ManWireCapObj(p, i, nFans) );
         }
     }
     // choice classes (after &dch): every sibling implements the same function
@@ -1562,6 +1752,8 @@ void Nf_ManComputeLoads( Nf_Man_t * p )
         printf( "Loads (round %d): %d mapped refs, mean %.2f fF, max %.2f fF\n", p->Iter, nUsed, Sum / Abc_MaxInt(1, Gia_ManAndNum(p->pGia)), Max );
     }
     Vec_IntFree( vFans );
+    Vec_FltFreeP( &vBx0 ); Vec_FltFreeP( &vBx1 );
+    Vec_FltFreeP( &vBy0 ); Vec_FltFreeP( &vBy1 );
 }
 void Nf_ManComputeMapping( Nf_Man_t * p )
 {
@@ -1632,7 +1824,35 @@ void Nf_ManSetOutputRequireds( Nf_Man_t * p, int fPropCompl )
         iObj     = Gia_ObjFaninId0p(p->pGia, pObj);
         fCompl   = Gia_ObjFaninC0(pObj);
         Required = Nf_ObjMatchD(p, iObj, fCompl)->D;
-        Required = p->pPars->fDoAverage ? Required * (100 + p->pPars->nRelaxRatio) / 100 : p->pPars->MapDelay;
+        // `-t`: budget this output against the arrival it had under the FIRST
+        // (delay-optimal) mapping, not against the arrival it has now.  The
+        // upstream expression re-reads the current arrival every iteration,
+        // so with a non-zero relaxation ratio the budget compounds -- the
+        // critical path nearly doubled in levels over the area-recovery rounds on
+        // ibex at -R 25, and ABC's own "Critical delay violation" line fired
+        // three times.  Freezing the baseline makes -R a one-shot percentage
+        // of the delay-optimal depth, which is what it reads as.
+        if ( p->pPars->fDoAverage )
+        {
+            if ( p->vCoArr0 == NULL )
+                p->vCoArr0 = Vec_IntAlloc( Gia_ManCoNum(p->pGia) );
+            Vec_IntFillExtra( p->vCoArr0, i + 1, 0 );
+            if ( p->Iter == 0 || Vec_IntEntry(p->vCoArr0, i) == 0 )
+                Vec_IntWriteEntry( p->vCoArr0, i, Required );
+            Required = Vec_IntEntry( p->vCoArr0, i ) * (100 + p->pPars->nRelaxRatio) / 100;
+            // Under load-aware delays (-l) the loads change between rounds,
+            // so the frozen baseline can sit below the arrival the CURRENT
+            // best match already has; Ela asserts `pM->D <= Required`. Never
+            // budget below the present arrival.
+            Required = Abc_MaxInt( Required, Nf_ObjMatchD(p, iObj, fCompl)->D );
+            // An explicit -D target is a budget every output may use: cones
+            // faster than the clock target may be relaxed up to it (that is
+            // free), but never toward an unrelated deep cone's arrival.
+            if ( p->pPars->MapDelayTarget > 0 )
+                Required = Abc_MaxInt( Required, p->pPars->MapDelayTarget );
+        }
+        else
+            Required = p->pPars->MapDelay;
         // if external required time can be achieved, use it
         if ( fUseConMan )
         {
