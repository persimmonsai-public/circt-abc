     return 1;
 }
 
+int Scl_CommandWritePlace( Abc_Frame_t * pAbc, int argc, char ** argv )
+{
+    Abc_Ntk_t * pNtk = Abc_FrameReadNtk(pAbc);
+    int c;
+    Extra_UtilGetoptReset();
+    while ( ( c = Extra_UtilGetopt( argc, argv, "h" ) ) != EOF )
+    {
+        switch ( c )
+        {
+        case 'h':
+        default:
+            goto usage;
+        }
+    }
+    if ( argc != globalUtilOptind + 1 )
+        goto usage;
+    if ( pNtk == NULL )
+    {
+        fprintf( pAbc->Err, "There is no current network.\n" );
+        return 1;
+    }
+    Scl_PlaceWriteByGateOrder( pNtk, argv[globalUtilOptind] );
+    return 0;
+
+usage:
+    fprintf( pAbc->Err, "usage: write_place [-h] <file>\n" );
+    fprintf( pAbc->Err, "\t         writes coordinates keyed by write_verilog's g<K> gate order\n" );
+    fprintf( pAbc->Err, "\t         (call immediately after write_verilog, same network)\n" );
+    fprintf( pAbc->Err, "\t<file> : output file\n" );
+    return 1;
+}
