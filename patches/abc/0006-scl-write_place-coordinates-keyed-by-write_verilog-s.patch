 {
     Abc_Ntk_t * pNtk = Abc_FrameReadNtk(pAbc);
diff --git a/src/map/scl/sclPlace.c b/src/map/scl/sclPlace.c
index 2fd3c78cd..77c6d8589 100644
--- a/src/map/scl/sclPlace.c
+++ b/src/map/scl/sclPlace.c
@@ -396,6 +396,59 @@ void Scl_PlaceTransfer( Abc_Ntk_t * pNtkOld, Abc_Ntk_t * pNtkNew )
     s_pSclPlace->pNtk = pNtkNew;
 }
 
+/**Function*************************************************************
+
+  Synopsis    [Writes coordinates keyed by write_verilog's gate order.]
+
+  Description [write_verilog names gates g<K> by Abc_NtkForEachNode
+  order with Abc_Base10Log(node count) digits; iterating the SAME order
+  here (with no network change in between) gives an exact
+  instance-name <-> coordinate correspondence for the freshly written
+  netlist -- the piece an incremental (legalize-only) placement needs.
+  Unlocated nodes inherit the last located coordinate in topological
+  order (their driver's neighbourhood), so every gate gets a seed.]
+
+***********************************************************************/
+int Scl_PlaceWriteByGateOrder( Abc_Ntk_t * pNtk, char * pFileName )
+{
+    FILE * pFile;
+    Abc_Obj_t * pObj;
+    float x, y, lastX = 0, lastY = 0;
+    int i, Counter = 0, nDigits, nLocated = 0, fHave = 0;
+    if ( !Scl_PlaceIsRunning(pNtk) )
+    {
+        printf( "write_place: no placement loaded for the current network.\n" );
+        return 0;
+    }
+    pFile = fopen( pFileName, "wb" );
+    if ( pFile == NULL )
+    {
+        printf( "write_place: cannot open \"%s\".\n", pFileName );
+        return 0;
+    }
+    nDigits = Abc_Base10Log( Abc_NtkNodeNum(pNtk) );
+    fprintf( pFile, "# gate-order placement (write_verilog g<K> naming)\n" );
+    fprintf( pFile, "capacitance_per_um %g\n", Scl_PlaceCapPerUm() );
+    fprintf( pFile, "resistance_per_um %g\n", Scl_PlaceResPerUm() );
+    Abc_NtkForEachNode( pNtk, pObj, i )
+    {
+        if ( Scl_PlaceObjCoord( pNtk, Abc_ObjId(pObj), &x, &y ) )
+        {
+            lastX = x; lastY = y; fHave = 1; nLocated++;
+        }
+        else if ( !fHave )
+        {
+            Counter++;
+            continue; // no coordinate seen yet; caller seeds these
+        }
+        fprintf( pFile, "g%0*d %.3f %.3f\n", nDigits, Counter++, lastX, lastY );
+    }
+    fclose( pFile );
+    printf( "write_place: %d gates written (%d exactly located) to \"%s\".\n",
+            Counter, nLocated, pFileName );
+    return 1;
+}
