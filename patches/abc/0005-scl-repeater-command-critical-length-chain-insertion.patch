diff --git a/src/map/scl/sclDrc.c b/src/map/scl/sclDrc.c
index 160f0570b..41dbc0ec8 100644
--- a/src/map/scl/sclDrc.c
+++ b/src/map/scl/sclDrc.c
@@ -117,6 +117,123 @@ int Abc_SclDrcSizePerform( SC_Lib * pLib, Abc_Ntk_t * pNtk, float SlewLimit,
     return nTotal;
 }
 
+/**Function*************************************************************
+
+  Synopsis    [Critical-length repeater insertion on placed nets.]
+
+  Description [The buffering engine decomposes FANOUT, never DISTANCE: a
+  single-sink net spanning 500um gets at most one buffer at the sink, so
+  wire-dominated nets stay outside NLDM characterization no matter the
+  drive (measured: ~500k slew-limit violations on an unrepaired 2.25M-cell
+  design, unchanged by max-drive sizing). This pass walks every located
+  driver->sink edge and, where the Manhattan distance exceeds LcritUm,
+  splits the edge with ceil(d/Lcrit)-1 chained buffers at interpolated
+  coordinates (Scl_PlaceSetObjCoord), so subsequent placement-aware
+  sizing sees per-stage spans <= Lcrit. Optimal spacing is
+  sqrt(2*Rbuf*Cbuf/(r*c)). Far sinks of one driver
+  each get their own chain (v1; no trunk sharing). Requires read_place.]
+
+***********************************************************************/
+int Abc_SclInsertRepeaters( SC_Lib * pLib, Abc_Ntk_t * pNtk, float LcritUm,
+                            int fVerbose )
+{
+    SC_Cell * pBufClass, * pBufCell;
+    Abc_Obj_t * pObj, * pFanout, * pPrev, * pRep;
+    Vec_Int_t * vEdges;
+    float xd, yd, xs, ys, d;
+    int i, k, K, nAdded = 0, nEdges = 0, MaxStages = 16;
+    if ( !Scl_PlaceIsRunning(pNtk) )
+    {
+        printf( "repeater: no placement loaded (read_place first); nothing done.\n" );
+        return 0;
+    }
+    // mid-strength buffer: smallest variant of the buffer class whose
+    // max_out_cap covers one Lcrit segment of wire plus its own input cap
+    pBufClass = Abc_SclFindInvertor( pLib, 1 );
+    if ( pBufClass == NULL )
+    {
+        printf( "repeater: no buffer class in the library.\n" );
+        return 0;
+    }
+    {
+        float SegCap = LcritUm * Scl_PlaceCapPerUm()
+                     + SC_CellPinCapAve( pBufClass->pRepr );
+        SC_Cell * pTemp; int t;
+        pBufCell = pBufClass->pRepr->pPrev; // fallback: largest
+        SC_RingForEachCell( pBufClass->pRepr, pTemp, t )
+        {
+            SC_Pin * pPo = SC_CellPin( pTemp, pTemp->n_inputs );
+            if ( pPo->max_out_cap >= 1.5 * SegCap )
+            {
+                pBufCell = pTemp;
+                break;
+            }
+        }
+    }
+    // collect long edges first (insertion must not disturb iteration)
+    vEdges = Vec_IntAlloc( 1000 );
+    Abc_NtkForEachObj( pNtk, pObj, i )
+    {
+        if ( !Abc_ObjIsNode(pObj) && !Abc_ObjIsCi(pObj) )
+            continue;
+        if ( !Scl_PlaceObjCoord( pNtk, Abc_ObjId(pObj), &xd, &yd ) )
+            continue;
+        Abc_ObjForEachFanout( pObj, pFanout, k )
+        {
+            if ( Abc_ObjIsCo(pFanout) )
+                continue;
+            if ( !Scl_PlaceObjCoord( pNtk, Abc_ObjId(pFanout), &xs, &ys ) )
+                continue;
+            if ( Abc_AbsFloat(xs - xd) + Abc_AbsFloat(ys - yd) <= LcritUm )
+                continue;
+            Vec_IntPush( vEdges, Abc_ObjId(pObj) );
+            Vec_IntPush( vEdges, Abc_ObjId(pFanout) );
+        }
+    }
+    for ( i = 0; i < Vec_IntSize(vEdges); i += 2 )
+    {
+        pObj    = Abc_NtkObj( pNtk, Vec_IntEntry(vEdges, i) );
+        pFanout = Abc_NtkObj( pNtk, Vec_IntEntry(vEdges, i+1) );
+        Scl_PlaceObjCoord( pNtk, Abc_ObjId(pObj), &xd, &yd );
+        Scl_PlaceObjCoord( pNtk, Abc_ObjId(pFanout), &xs, &ys );
+        d = Abc_AbsFloat(xs - xd) + Abc_AbsFloat(ys - yd);
+        K = (int)(d / LcritUm); // ceil(d/Lcrit)-1 for d > Lcrit
+        K = Abc_MinInt( K, MaxStages );
+        if ( K < 1 )
+            continue;
+        nEdges++;
+        pPrev = pObj;
+        for ( k = 1; k <= K; k++ )
+        {
+            pRep = Abc_NtkCreateNodeBuf( pNtk, NULL );
+            Vec_IntSetEntry( pNtk->vGates, Abc_ObjId(pRep), pBufCell->Id );
+            Abc_ObjAddFanin( pRep, pPrev );
+            Scl_PlaceSetObjCoord( pNtk, Abc_ObjId(pRep),
+                xd + (xs - xd) * k / (K + 1), yd + (ys - yd) * k / (K + 1) );
+            pPrev = pRep;
+            nAdded++;
+        }
+        Abc_ObjPatchFanin( pFanout, pObj, pPrev );
+    }
+    Vec_IntFree( vEdges );
+    if ( pNtk->vPhases )
+        Vec_IntFillExtra( pNtk->vPhases, Abc_NtkObjNumMax(pNtk), 0 );
+    printf( "repeater: split %d long edge(s) with %d %s repeater(s) "
+            "(Lcrit %.1f um).\n", nEdges, nAdded, pBufCell->pName, LcritUm );
+    return nAdded;
+}
+
+Abc_Ntk_t * Abc_SclRepeaterPerform( SC_Lib * pLib, Abc_Ntk_t * pNtk,
+                                    float LcritUm, int fVerbose )
+{
+    Abc_Ntk_t * pNtkNew;
+    Abc_SclMioGates2SclGates( pLib, pNtk );
+    Abc_SclInsertRepeaters( pLib, pNtk, LcritUm, fVerbose );
+    Abc_SclSclGates2MioGates( pLib, pNtk );
+    pNtkNew = Abc_NtkDupDfs( pNtk );
+    return pNtkNew;
+}
