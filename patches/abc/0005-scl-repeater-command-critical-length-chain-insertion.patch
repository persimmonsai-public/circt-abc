+int Scl_CommandRepeater( Abc_Frame_t * pAbc, int argc, char ** argv )
+{
+    Abc_Ntk_t * pNtkRes, * pNtk = Abc_FrameReadNtk(pAbc);
+    float LcritUm = 60;
+    int c, fVerbose = 0;
+    Extra_UtilGetoptReset();
+    while ( ( c = Extra_UtilGetopt( argc, argv, "Lvh" ) ) != EOF )
+    {
+        switch ( c )
+        {
+        case 'L':
+            if ( globalUtilOptind >= argc ) goto usage;
+            LcritUm = atof(argv[globalUtilOptind]);
+            globalUtilOptind++;
+            break;
+        case 'v':
+            fVerbose ^= 1;
+            break;
+        case 'h':
+        default:
+            goto usage;
+        }
+    }
+    if ( pNtk == NULL || !Abc_NtkHasMapping(pNtk) )
+    {
+        fprintf( pAbc->Err, "There is no current mapped network.\n" );
+        return 1;
+    }
+    if ( pAbc->pLibScl == NULL )
+    {
+        fprintf( pAbc->Err, "There is no Liberty library available.\n" );
+        return 1;
+    }
+    pNtkRes = Abc_SclRepeaterPerform( (SC_Lib *)pAbc->pLibScl, pNtk, LcritUm, fVerbose );
+    if ( pNtkRes == NULL )
+    {
+        fprintf( pAbc->Err, "Repeater insertion failed.\n" );
+        return 1;
+    }
+    // node names do not survive the dup; carry the placement across
+    Scl_PlaceTransfer( pNtk, pNtkRes );
+    Abc_FrameReplaceCurrentNetwork( pAbc, pNtkRes );
+    return 0;
+
+usage:
+    fprintf( pAbc->Err, "usage: repeater [-L float] [-vh]\n" );
+    fprintf( pAbc->Err, "\t         splits placed driver->sink edges longer than Lcrit\n" );
+    fprintf( pAbc->Err, "\t         with chained buffers at interpolated coordinates\n" );
+    fprintf( pAbc->Err, "\t-L num : critical length in um [default = 60]\n" );
+    fprintf( pAbc->Err, "\t-v     : verbose\n" );
+    fprintf( pAbc->Err, "\t-h     : help\n" );
+    return 1;
+}
