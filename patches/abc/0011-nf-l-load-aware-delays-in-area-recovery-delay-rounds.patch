     Abc_Print( -2, "\t-X num   : load clamp in fF for load-aware delays (0 = none) [default = %.1f]\n", pPars->MaxLoadF );
     Abc_Print( -2, "\t-P num   : per-stage delay penalty in ps for load-aware delays (wire RC + slew per level) [default = %.1f]\n", pPars->StagePenaltyPs );
+    Abc_Print( -2, "\t-Y num   : extra delay rounds under the previous mapping's loads before loads are frozen for area recovery (-l) [default = %d]\n", pPars->nLoadRounds );
     Abc_Print( -2, "\t-v       : toggles verbose output [default = %s]\n",                                   pPars->fVerbose? "yes": "no" );
     Abc_Print( -2, "\t-w       : toggles very verbose output [default = %s]\n",                              pPars->fVeryVerbose? "yes": "no" );
     Abc_Print( -2, "\t-h       : prints the command usage\n");
