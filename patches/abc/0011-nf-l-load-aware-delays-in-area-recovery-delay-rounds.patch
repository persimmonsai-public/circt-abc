     // update global stats
@@ -1944,7 +1945,7 @@ word Nf_MatchRef_rec( Nf_Man_t * p, int i, int c, Nf_Mat_t * pM, int Required, V
     pCut = Nf_CutFromHandle( Nf_ObjCutSet(p, i), pM->CutH );
     Nf_CutForEachVarCompl( pCut, pM->Cfg, iVar, fCompl, k )
     {
-        ReqFanin = Required - Nf_ManCell(p, pM->Gate)->iDelays[k];
+        ReqFanin = Required - Nf_CellPinDelay(p, Nf_ManCell(p, pM->Gate), k, i);
         if ( vBackup )
             Vec_IntPush( vBackup, Abc_Var2Lit(iVar, fCompl) );
         assert( Nf_ObjMapRefNum(p, iVar, fCompl) >= 0 );
@@ -2013,7 +2014,7 @@ void Nf_ManElaBestMatchOne( Nf_Man_t * p, int iObj, int c, int * pCut, int * pCu
         {
             pMd     = &pBestF[iFanin]->M[fComplF][0];
             assert( pMd->fBest );
-            Delay = Abc_MaxInt( Delay, pMd->D + pC->iDelays[k] );
+            Delay = Abc_MaxInt( Delay, pMd->D + Nf_CellPinDelay(p, pC, k, iObj) );
             if ( Delay > Required )
                 break;
         }
@@ -2047,9 +2048,9 @@ void Nf_ManElaBestMatch( Nf_Man_t * p, int iObj, int c, Nf_Mat_t * pRes, int Req
         Nf_ManElaBestMatchOne( p, iObj, c, pCut, pCutSet, pRes, Required );
     }
 }
-int Nf_ManComputeArrival( Nf_Man_t * p, Nf_Mat_t * pM, int * pCutSet )
+int Nf_ManComputeArrival( Nf_Man_t * p, Nf_Mat_t * pM, int * pCutSet, int iObj )
 {
-    int Delay = 0; 
+    int Delay = 0;
     Nf_Mat_t * pMfan;
     int iVar, fCompl, k;
     Mio_Cell2_t * pCell = Nf_ManCell( p, pM->Gate );
@@ -2058,7 +2059,7 @@ int Nf_ManComputeArrival( Nf_Man_t * p, Nf_Mat_t * pM, int * pCutSet )
     Nf_CutForEachVarCompl( pCut, pM->Cfg, iVar, fCompl, k )
