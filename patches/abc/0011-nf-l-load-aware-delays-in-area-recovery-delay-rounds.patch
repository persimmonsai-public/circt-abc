     }
     //if ( pM->fCompl ) Delay += p->InvDelayI;
     return Delay;
@@ -2139,7 +2140,7 @@ void Nf_ManResetMatches( Nf_Man_t * p, int Round )
         {
             for ( c = 0; c < 2; c++ )
             {
-                Arrival = Nf_ManComputeArrival( p, pM[c], Nf_ObjCutSet(p, i) );
+                Arrival = Nf_ManComputeArrival( p, pM[c], Nf_ObjCutSet(p, i), i );
                 //if ( Nf_ObjMapRefNum(p, i, c) )
                 //    assert( Round || Arrival <= pM[c]->D );
                 pM[c]->D = Arrival;
@@ -2151,7 +2152,7 @@ void Nf_ManResetMatches( Nf_Man_t * p, int Round )
             c = !pM[1]->fCompl;
             assert( !pM[c]->fCompl );
             assert( pM[!c]->fCompl );
-            Arrival = Nf_ManComputeArrival( p, pM[c], Nf_ObjCutSet(p, i) );
+            Arrival = Nf_ManComputeArrival( p, pM[c], Nf_ObjCutSet(p, i), i );
             //if ( Nf_ObjMapRefNum(p, i, c) )
             //    assert( Round || Arrival <= pM[c]->D );
             pM[c]->D = Arrival;
@@ -2246,13 +2247,13 @@ void Nf_ManComputeMappingEla( Nf_Man_t * p )
             Nf_CutForEachVarCompl( pCut, pMb->Cfg, iVar, fCompl, k )
             {
                 pM = Nf_ObjMatchBest( p, iVar, fCompl );
-                assert( pM->D <= Required - pCell->iDelays[k] );
-                Nf_ObjUpdateRequired( p, iVar, fCompl, Required - pCell->iDelays[k] );
+                assert( pM->D <= Required - Nf_CellPinDelay(p, pCell, k, i) );
+                Nf_ObjUpdateRequired( p, iVar, fCompl, Required - Nf_CellPinDelay(p, pCell, k, i) );
                 if ( pM->fCompl )
                 {
                     pM = Nf_ObjMatchBest( p, iVar, !fCompl );
-                    assert( pM->D <= Required - pCell->iDelays[k] - p->InvDelayI );
-                    Nf_ObjUpdateRequired( p, iVar, !fCompl, Required - pCell->iDelays[k] - p->InvDelayI );
+                    assert( pM->D <= Required - Nf_CellPinDelay(p, pCell, k, i) - p->InvDelayI );
+                    Nf_ObjUpdateRequired( p, iVar, !fCompl, Required - Nf_CellPinDelay(p, pCell, k, i) - p->InvDelayI );
                 }
             }
         }
@@ -2846,6 +2847,7 @@ void Nf_ManSetDefaultPars( Jf_Par_t * pPars )
     pPars->MapDelayTarget = 0;
     pPars->MaxLoadF     = 30.0;
     pPars->StagePenaltyPs = 0.0;
+    pPars->nLoadRounds  =  2;
 }
 Gia_Man_t * Nf_ManPerformMappingInt( Gia_Man_t * pGia, Jf_Par_t * pPars )
 {
@@ -2889,11 +2891,31 @@ Gia_Man_t * Nf_ManPerformMappingInt( Gia_Man_t * pGia, Jf_Par_t * pPars )
 //            Nf_ObjPrepareCi( p, Id, Scl_Flt2Int(p->pGia->vInArrs ? Abc_MaxFloat(0.0, Vec_FltEntry(p->pGia->vInArrs, i)) : 0.0) );
             Nf_ObjPrepareCi( p, Id, Scl_Flt2Int(p->pGia->vInArrs ? Vec_FltEntry(p->pGia->vInArrs, i) : 0.0) );
     }
-    for ( p->Iter = 0; p->Iter < p->pPars->nRounds; p->Iter++ )
     {
-        Nf_ManComputeMapping( p );
-        Nf_ManSetMapRefs( p );
-        Nf_ManPrintStats( p, (char *)(p->Iter ? "Area " : "Delay") );
+        // Load-aware mode: the round-0 loads are a flow estimate; the loads
+        // of the mapping that round produces are different, so the mapping's
+        // arrivals violate the required times computed for it and the mapper
+        // relaxes MapDelay to the violated value -- area recovery then fills
+        // every path with cheap deep chains (nearly doubling the depth). Instead,
+        // re-run delay-oriented rounds under the previous mapping's loads
+        // (nLoadRounds of them), then freeze the loads for area recovery.
+        int nLoadRounds = p->pPars->fUseLoads ? p->pPars->nLoadRounds : 0;
+        for ( p->Iter = 0; p->Iter < p->pPars->nRounds + nLoadRounds; p->Iter++ )
+        {
+            int fDelayRound = p->Iter <= nLoadRounds;
+            if ( p->pPars->fUseLoads && p->Iter > 0 && fDelayRound )
+            {
+                Vec_IntFill( &p->vRequired, Vec_IntSize(&p->vRequired), SCL_INFINITY );
+                p->pPars->MapDelay = 0;
+            }
+            if ( p->pPars->fUseLoads && p->Iter > nLoadRounds )
+                p->fFreezeLoads = 1;
+            Nf_ManComputeMapping( p );
+            Nf_ManSetMapRefs( p );
+            Nf_ManPrintStats( p, (char *)(fDelayRound ? "Delay" : "Area ") );
+        }
+        // the exact-area rounds index themselves by (Iter - nRounds)
+        p->Iter = p->pPars->nRounds;
     }
 
     p->fUseEla = 1;
