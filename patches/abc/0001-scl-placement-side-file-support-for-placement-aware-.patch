diff --git a/src/map/scl/sclPlace.c b/src/map/scl/sclPlace.c
new file mode 100644
index 000000000..254a76fb7
--- /dev/null
+++ b/src/map/scl/sclPlace.c
@@ -0,0 +1,346 @@
+/**CFile****************************************************************
+
+  FileName    [sclPlace.c]
+
+  SystemName  [ABC: Logic synthesis and verification system.]
+
+  PackageName [Standard-cell library representation.]
+
+  Synopsis    [Placement side-file support for placement-aware sizing.]
+
+  Author      [circt-abc project]
+
+  Affiliation [-]
+
+  Date        [Started 2026-09-02.]
+
+  Revision    []
+
+***********************************************************************/
+
+#include "sclSize.h"
+#include "misc/st/st.h"
+
+ABC_NAMESPACE_IMPL_START
+
+////////////////////////////////////////////////////////////////////////
+///                        DECLARATIONS                              ///
+////////////////////////////////////////////////////////////////////////
+
+// Placement annotation for the current network, loaded from a side file
+// produced by the flow's coordinate extractor. Keys are OUTPUT NET names
+// (the only identity that survives ABC's own write_verilog/read_verilog -m
+// round trip: instance names are discarded on read); values are cell
+// locations in microns. CI coordinates are keyed by the PI name, CO
+// coordinates by the PO name (die pin locations).
+//
+// File format (text, whitespace-separated):
+//   # comment
+//   capacitance_per_um <fF/um>
+//   resistance_per_um  <kOhm/um>
+//   <net-or-port-name> <x_um> <y_um>
+//   <port-name>@pin    <x_um> <y_um>     (die pin location; the plain name
+//                                         is the boundary cell's location)
+//
+// UNITS ARE ABC'S SCL-INTERNAL UNITS, NOT THE LIBERTY'S: the SCL layer
+// rescales liberty values to ps/fF/kOhm on load, and read_place values go
+// straight into SC_Pair loads. fF/um * um = fF on the NLDM load axis;
+// kOhm/um * fF/um keeps R*C in ps for a later Elmore term.
+
+#define SCL_PLACE_NOCOORD ((float)1e30)
+
+typedef struct Scl_Place_t_ Scl_Place_t;
+struct Scl_Place_t_
+{
+    char *      pFileName;
+    Abc_Ntk_t * pNtk;        // network the coordinates were resolved against
+    float       CapPerUm;    // fF per micron of estimated wire (SCL units)
+    float       ResPerUm;    // kOhm per micron (reserved for Elmore later)
+    Vec_Flt_t * vX;          // indexed by object Id; SCL_PLACE_NOCOORD if absent
+    Vec_Flt_t * vY;
+    int         nEntries;    // entries in the file
+    int         nMatched;    // entries resolved to a network object
+    int         nFallbacks;  // nets that fell back to the wire-load table
+};
+
+static Scl_Place_t * s_pSclPlace = NULL;
+
+////////////////////////////////////////////////////////////////////////
+///                     FUNCTION DEFINITIONS                         ///
+////////////////////////////////////////////////////////////////////////
+
+void Scl_PlaceStop()
+{
+    if ( s_pSclPlace == NULL )
+        return;
+    Vec_FltFreeP( &s_pSclPlace->vX );
+    Vec_FltFreeP( &s_pSclPlace->vY );
+    ABC_FREE( s_pSclPlace->pFileName );
+    ABC_FREE( s_pSclPlace );
+    s_pSclPlace = NULL;
+}
+
+int Scl_PlaceIsRunning( Abc_Ntk_t * pNtk )
+{
+    return s_pSclPlace != NULL && s_pSclPlace->pNtk == pNtk;
+}
+
+float Scl_PlaceCapPerUm() { return s_pSclPlace ? s_pSclPlace->CapPerUm : 0; }
+float Scl_PlaceResPerUm() { return s_pSclPlace ? s_pSclPlace->ResPerUm : 0; }
+
+int Scl_PlaceObjCoord( Abc_Ntk_t * pNtk, int Id, float * pX, float * pY )
+{
+    if ( !Scl_PlaceIsRunning(pNtk) )
+        return 0;
+    if ( Id >= Vec_FltSize(s_pSclPlace->vX) )
+        return 0; // object created after read_place (e.g. a new buffer)
+    *pX = Vec_FltEntry( s_pSclPlace->vX, Id );
+    *pY = Vec_FltEntry( s_pSclPlace->vY, Id );
+    return *pX != SCL_PLACE_NOCOORD && *pY != SCL_PLACE_NOCOORD;
+}
+
+void Scl_PlaceSetObjCoord( Abc_Ntk_t * pNtk, int Id, float X, float Y )
+{
+    if ( s_pSclPlace == NULL || s_pSclPlace->pNtk != pNtk )
+        return;
+    Vec_FltFillExtra( s_pSclPlace->vX, Id + 1, SCL_PLACE_NOCOORD );
+    Vec_FltFillExtra( s_pSclPlace->vY, Id + 1, SCL_PLACE_NOCOORD );
+    Vec_FltWriteEntry( s_pSclPlace->vX, Id, X );
+    Vec_FltWriteEntry( s_pSclPlace->vY, Id, Y );
+}
+
+/**Function*************************************************************
+
+  Synopsis    [HPWL-based wire cap for the net driven by pObj.]
+
+  Description [Returns 1 and fills *pCap with cap_per_um * HPWL over the
+  driver and all fanout locations. Returns 0 (caller falls back to the
+  fanout-count wire-load table) if placement is not loaded for this
+  network or any member of the net lacks a coordinate.]
+
+***********************************************************************/
+int Scl_PlaceNetWireCap( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj, float * pCap )
+{
+    Abc_Obj_t * pFanout;
+    float x, y, xMin, xMax, yMin, yMax;
+    int i;
+    if ( !Scl_PlaceIsRunning(pNtk) )
+        return 0;
+    if ( !Scl_PlaceObjCoord( pNtk, Abc_ObjId(pObj), &x, &y ) )
+        { s_pSclPlace->nFallbacks++; return 0; }
+    xMin = xMax = x;
+    yMin = yMax = y;
+    Abc_ObjForEachFanout( pObj, pFanout, i )
+    {
+        if ( !Scl_PlaceObjCoord( pNtk, Abc_ObjId(pFanout), &x, &y ) )
+            { s_pSclPlace->nFallbacks++; return 0; }
+        xMin = Abc_MinFloat( xMin, x );
+        xMax = Abc_MaxFloat( xMax, x );
+        yMin = Abc_MinFloat( yMin, y );
+        yMax = Abc_MaxFloat( yMax, y );
+    }
+    *pCap = s_pSclPlace->CapPerUm * ( (xMax - xMin) + (yMax - yMin) );
+    return 1;
+}
+
+/**Function*************************************************************
+
+  Synopsis    [Reads a placement side file and resolves it to pNtk.]
+
+***********************************************************************/
+int Scl_PlaceReadFile( Abc_Ntk_t * pNtk, char * pFileName, int fVerbose )
+{
+    char Buffer[4096];
+    char * pToken, * pTokX, * pTokY;
+    FILE * pFile;
+    st__table * tName2Idx;
+    Vec_Flt_t * vFileX, * vFileY;
+    Vec_Ptr_t * vFileNames;
+    Abc_Obj_t * pObj;
+    char * pName;
+    int i, Idx, nLines = 0;
+    float CapPerUm = 0, ResPerUm = 0;
+
+    pFile = fopen( pFileName, "rb" );
+    if ( pFile == NULL )
+    {
+        printf( "Cannot open placement file \"%s\".\n", pFileName );
+        return 0;
+    }
+
+    // parse the file into name -> (x, y)
+    tName2Idx  = st__init_table( strcmp, st__strhash );
+    vFileX     = Vec_FltAlloc( 1000 );
+    vFileY     = Vec_FltAlloc( 1000 );
+    vFileNames = Vec_PtrAlloc( 1000 );
+    while ( fgets( Buffer, sizeof(Buffer), pFile ) )
+    {
+        nLines++;
+        pToken = strtok( Buffer, " \t\r\n" );
+        if ( pToken == NULL || pToken[0] == '#' )
+            continue;
+        if ( !strcmp(pToken, "capacitance_per_um") )
+        {
+            pTokX = strtok( NULL, " \t\r\n" );
+            if ( pTokX ) CapPerUm = atof( pTokX );
+            continue;
+        }
+        if ( !strcmp(pToken, "resistance_per_um") )
+        {
+            pTokX = strtok( NULL, " \t\r\n" );
+            if ( pTokX ) ResPerUm = atof( pTokX );
+            continue;
+        }
+        pTokX = strtok( NULL, " \t\r\n" );
+        pTokY = strtok( NULL, " \t\r\n" );
+        if ( pTokX == NULL || pTokY == NULL )
+        {
+            printf( "Line %d: expected \"<name> <x> <y>\"; skipping.\n", nLines );
+            continue;
+        }
+        if ( st__is_member( tName2Idx, pToken ) )
+            continue; // first entry wins
+        pName = Abc_UtilStrsav( pToken );
+        Vec_PtrPush( vFileNames, pName );
+        st__insert( tName2Idx, pName, (char *)(ABC_PTRINT_T)Vec_FltSize(vFileX) );
+        Vec_FltPush( vFileX, atof(pTokX) );
+        Vec_FltPush( vFileY, atof(pTokY) );
+    }
+    fclose( pFile );
+
+    if ( CapPerUm <= 0 )
+    {
+        printf( "Placement file \"%s\" has no positive capacitance_per_um; refusing to load.\n", pFileName );
+        st__free_table( tName2Idx );
+        Vec_PtrForEachEntry( char *, vFileNames, pName, i ) ABC_FREE( pName );
+        Vec_PtrFree( vFileNames );
+        Vec_FltFree( vFileX );
+        Vec_FltFree( vFileY );
+        return 0;
+    }
+
+    // resolve against the network: CIs and COs by their own name, nodes by
+    // their output net name (Abc_ObjName of the node in a logic network)
+    Scl_PlaceStop();
+    s_pSclPlace = ABC_CALLOC( Scl_Place_t, 1 );
+    s_pSclPlace->pFileName = Abc_UtilStrsav( pFileName );
+    s_pSclPlace->pNtk      = pNtk;
+    s_pSclPlace->CapPerUm  = CapPerUm;
+    s_pSclPlace->ResPerUm  = ResPerUm;
+    s_pSclPlace->vX = Vec_FltStartFull( Abc_NtkObjNumMax(pNtk) );
+    s_pSclPlace->vY = Vec_FltStartFull( Abc_NtkObjNumMax(pNtk) );
+    Vec_FltFill( s_pSclPlace->vX, Abc_NtkObjNumMax(pNtk), SCL_PLACE_NOCOORD );
+    Vec_FltFill( s_pSclPlace->vY, Abc_NtkObjNumMax(pNtk), SCL_PLACE_NOCOORD );
+    s_pSclPlace->nEntries = Vec_FltSize( vFileX );
+
+    Abc_NtkForEachObj( pNtk, pObj, i )
+    {
+        char * pObjName, * pVal;
+        char PinName[4200];
+        if ( !Abc_ObjIsNode(pObj) && !Abc_ObjIsCi(pObj) && !Abc_ObjIsCo(pObj) )
+            continue;
+        pObjName = Abc_ObjName( pObj );
+        if ( pObjName == NULL )
+            continue;
+        // a CI/CO and the net at the boundary share a name, but the die pin
+        // and the driving/driven cell are different locations -- port pins
+        // are keyed "<name>@pin" when the extractor distinguishes them
+        if ( (Abc_ObjIsCi(pObj) || Abc_ObjIsCo(pObj)) && strlen(pObjName) < 4096 )
+        {
+            sprintf( PinName, "%s@pin", pObjName );
+            if ( st__lookup( tName2Idx, PinName, &pVal ) )
+            {
+                Idx = (int)(ABC_PTRINT_T)pVal;
+                Vec_FltWriteEntry( s_pSclPlace->vX, i, Vec_FltEntry(vFileX, Idx) );
+                Vec_FltWriteEntry( s_pSclPlace->vY, i, Vec_FltEntry(vFileY, Idx) );
+                s_pSclPlace->nMatched++;
+                continue;
+            }
+        }
+        if ( st__lookup( tName2Idx, pObjName, &pVal ) )
+        {
+            Idx = (int)(ABC_PTRINT_T)pVal;
+            Vec_FltWriteEntry( s_pSclPlace->vX, i, Vec_FltEntry(vFileX, Idx) );
+            Vec_FltWriteEntry( s_pSclPlace->vY, i, Vec_FltEntry(vFileY, Idx) );
+            s_pSclPlace->nMatched++;
+        }
+        else if ( fVerbose && s_pSclPlace->nEntries - s_pSclPlace->nMatched < 20 )
+            printf( "read_place: no entry for %s object \"%s\" (id %d).\n",
+                    Abc_ObjIsNode(pObj) ? "node" : (Abc_ObjIsCi(pObj) ? "CI" : "CO"),
+                    pObjName, i );
+    }
+
+    if ( fVerbose || s_pSclPlace->nMatched == 0 )
+        printf( "read_place: %d file entries, %d matched of %d network objects (cap %.6f fF/um, res %.6f kOhm/um).\n",
+                s_pSclPlace->nEntries, s_pSclPlace->nMatched,
+                Abc_NtkObjNum(pNtk), CapPerUm, ResPerUm );
+
+    st__free_table( tName2Idx );
+    Vec_PtrForEachEntry( char *, vFileNames, pName, i ) ABC_FREE( pName );
+    Vec_PtrFree( vFileNames );
+    Vec_FltFree( vFileX );
+    Vec_FltFree( vFileY );
+    if ( s_pSclPlace->nMatched == 0 )
+    {
+        Scl_PlaceStop();
+        return 0;
+    }
+    return 1;
+}
+
+/**Function*************************************************************
+
+  Synopsis    [Transfers the placement across a network duplication.]
+
+  Description [Call right after a dup that set pCopy on the old network's
+  objects (e.g. Abc_NtkDupDfs in the `topo` command); node names do not
+  survive such dups, so read_place should run before them and be carried
+  across by this.]
+
+***********************************************************************/
+void Scl_PlaceTransfer( Abc_Ntk_t * pNtkOld, Abc_Ntk_t * pNtkNew )
+{
+    Vec_Flt_t * vXNew, * vYNew;
+    Abc_Obj_t * pObj;
+    int i;
+    if ( !Scl_PlaceIsRunning(pNtkOld) )
+        return;
+    vXNew = Vec_FltStart( Abc_NtkObjNumMax(pNtkNew) );
+    vYNew = Vec_FltStart( Abc_NtkObjNumMax(pNtkNew) );
+    Vec_FltFill( vXNew, Abc_NtkObjNumMax(pNtkNew), SCL_PLACE_NOCOORD );
+    Vec_FltFill( vYNew, Abc_NtkObjNumMax(pNtkNew), SCL_PLACE_NOCOORD );
+    Abc_NtkForEachObj( pNtkOld, pObj, i )
+    {
+        if ( pObj->pCopy == NULL || i >= Vec_FltSize(s_pSclPlace->vX) )
+            continue;
+        if ( Abc_ObjId(pObj->pCopy) >= (unsigned)Vec_FltSize(vXNew) )
+            continue;
+        Vec_FltWriteEntry( vXNew, Abc_ObjId(pObj->pCopy), Vec_FltEntry(s_pSclPlace->vX, i) );
+        Vec_FltWriteEntry( vYNew, Abc_ObjId(pObj->pCopy), Vec_FltEntry(s_pSclPlace->vY, i) );
+    }
+    Vec_FltFree( s_pSclPlace->vX );
+    Vec_FltFree( s_pSclPlace->vY );
+    s_pSclPlace->vX = vXNew;
+    s_pSclPlace->vY = vYNew;
+    s_pSclPlace->pNtk = pNtkNew;
+}
+
+void Scl_PlacePrint( Abc_Ntk_t * pNtk )
+{
+    if ( s_pSclPlace == NULL )
+    {
+        printf( "No placement is loaded.\n" );
+        return;
+    }
+    printf( "Placement \"%s\": %d entries, %d matched, %s network, "
+            "cap %.6f fF/um, res %.6f kOhm/um, %d table fallbacks since load.\n",
+            s_pSclPlace->pFileName, s_pSclPlace->nEntries, s_pSclPlace->nMatched,
+            s_pSclPlace->pNtk == pNtk ? "CURRENT" : "STALE (different)",
+            s_pSclPlace->CapPerUm, s_pSclPlace->ResPerUm, s_pSclPlace->nFallbacks );
+}
+
+////////////////////////////////////////////////////////////////////////
+///                       END OF FILE                                ///
+////////////////////////////////////////////////////////////////////////
+
+ABC_NAMESPACE_IMPL_END
