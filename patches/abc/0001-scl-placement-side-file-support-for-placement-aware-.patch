+/**Function*************************************************************
+
+  Synopsis    [Placement side-file commands (see sclPlace.c).]
+
+  Description []
+
+  SideEffects []
+
+  SeeAlso     []
+
+***********************************************************************/
+int Scl_CommandReadPlace( Abc_Frame_t * pAbc, int argc, char ** argv )
+{
+    Abc_Ntk_t * pNtk = Abc_FrameReadNtk(pAbc);
+    char * pFileName;
+    int c, fVerbose = 0;
+    Extra_UtilGetoptReset();
+    while ( ( c = Extra_UtilGetopt( argc, argv, "vh" ) ) != EOF )
+    {
+        switch ( c )
+        {
+        case 'v':
+            fVerbose ^= 1;
+            break;
+        case 'h':
+            goto usage;
+        default:
+            goto usage;
+        }
+    }
+    if ( argc != globalUtilOptind + 1 )
+        goto usage;
+    if ( pNtk == NULL )
+    {
+        fprintf( pAbc->Err, "There is no current network.\n" );
+        return 1;
+    }
+    pFileName = argv[globalUtilOptind];
+    if ( !Scl_PlaceReadFile( pNtk, pFileName, fVerbose ) )
+    {
+        fprintf( pAbc->Err, "Reading placement file \"%s\" failed.\n", pFileName );
+        return 1;
+    }
+    return 0;
+
+usage:
+    fprintf( pAbc->Err, "usage: read_place [-vh] <file>\n" );
+    fprintf( pAbc->Err, "\t         reads cell placement (net-name x_um y_um) for the current network;\n" );
+    fprintf( pAbc->Err, "\t         stime/upsize/dnsize/buffer then use HPWL wire caps instead of the\n" );
+    fprintf( pAbc->Err, "\t         fanout-count wire-load table\n" );
+    fprintf( pAbc->Err, "\t-v     : toggle printing verbose information [default = %s]\n", fVerbose? "yes": "no" );
+    fprintf( pAbc->Err, "\t-h     : prints the command summary\n" );
+    fprintf( pAbc->Err, "\t<file> : the name of a file to read\n" );
+    return 1;
+}
+
+int Scl_CommandPrintPlace( Abc_Frame_t * pAbc, int argc, char ** argv )
+{
+    int c;
+    Extra_UtilGetoptReset();
+    while ( ( c = Extra_UtilGetopt( argc, argv, "h" ) ) != EOF )
+    {
+        switch ( c )
+        {
+        case 'h':
+        default:
+            fprintf( pAbc->Err, "usage: print_place [-h]\n" );
+            fprintf( pAbc->Err, "\t         prints the loaded placement's summary\n" );
+            return 1;
+        }
+    }
+    Scl_PlacePrint( Abc_FrameReadNtk(pAbc) );
+    return 0;
+}
+
+int Scl_CommandResetPlace( Abc_Frame_t * pAbc, int argc, char ** argv )
+{
+    int c;
+    Extra_UtilGetoptReset();
+    while ( ( c = Extra_UtilGetopt( argc, argv, "h" ) ) != EOF )
+    {
+        switch ( c )
+        {
+        case 'h':
+        default:
+            fprintf( pAbc->Err, "usage: reset_place [-h]\n" );
+            fprintf( pAbc->Err, "\t         removes the loaded placement\n" );
+            return 1;
+        }
+    }
+    Scl_PlaceStop();
+    return 0;
+}
+
