+/**Function*************************************************************
+  Synopsis    [Load-aware GENLIB: every cell, per pin PD/LD/cap (PHYS-ABC P6).]
+  Description [PIN <name> UNKNOWN <cap fF> 999 <PD ps> <LD ps/fF> <PD> <LD>.
+  The mapper (&nf -l) evaluates PD + LD*load(root) instead of a fixed
+  per-pin delay, and sees all drive variants of a function.]
+***********************************************************************/
+int Abc_SclComputeLoadDelayPin( SC_Lib * p, SC_Cell * pCell, int iPin, float Slew, float * pLDfF, float * pPD )
+{
+    SC_Pair Load0, Load1, Load2;
+    SC_Pair ArrIn  = { 0.0, 0.0 };
+    SC_Pair SlewIn = { Slew, Slew };
+    SC_Pair ArrOut0 = { 0.0, 0.0 }, ArrOut1 = { 0.0, 0.0 }, ArrOut2 = { 0.0, 0.0 };
+    SC_Pair SlewOut = { 0.0, 0.0 };
+    SC_Timing * pTime = Scl_CellPinTime( pCell, iPin );
+    Vec_Flt_t * vIndex = pTime ? &pTime->pCellRise.vIndex1 : NULL; // capacitance axis
+    if ( vIndex == NULL )
+        return 0;
+    if ( Vec_FltSize(vIndex) == 1 )
+    {
+        *pLDfF = 0;
+        *pPD = Vec_FltEntry( (Vec_Flt_t *)Vec_PtrEntry(&pTime->pCellRise.vData, 0), 0 );
+        return 1;
+    }
+    Load0.rise = Load0.fall = 0.0;
+    Load1.rise = Load1.fall = Vec_FltEntry( vIndex, 0 );
+    Load2.rise = Load2.fall = Vec_FltEntry( vIndex, Vec_FltSize(vIndex) - 2 );
+    Scl_LibPinArrival( pTime, &ArrIn, &SlewIn, &Load0, &ArrOut0, &SlewOut );
+    Scl_LibPinArrival( pTime, &ArrIn, &SlewIn, &Load1, &ArrOut1, &SlewOut );
+    Scl_LibPinArrival( pTime, &ArrIn, &SlewIn, &Load2, &ArrOut2, &SlewOut );
+    ArrOut0.rise = 0.5 * ArrOut0.rise + 0.5 * ArrOut0.fall;
+    ArrOut1.rise = 0.5 * ArrOut1.rise + 0.5 * ArrOut1.fall;
+    ArrOut2.rise = 0.5 * ArrOut2.rise + 0.5 * ArrOut2.fall;
+    *pLDfF = (Load2.rise > Load1.rise) ? (ArrOut2.rise - ArrOut1.rise) / (Load2.rise - Load1.rise) : 0;
+    *pPD   = ArrOut0.rise;
+    return 1;
+}
+Vec_Str_t * Abc_SclProduceGenlibStrLoad( SC_Lib * p, float Slew, int * pnCellCount )
+{
+    char Buffer[200];
+    Vec_Str_t * vStr;
+    SC_Cell * pCell;
+    SC_Pin * pPin, * pPinOut;
+    int i, j, k, Count = 2, nSkipped = 0;
+    Abc_SclMarkSkippedCells( p );
+    vStr = Vec_StrAlloc( 1000 );
+    Vec_StrPrintStr( vStr, "GATE _const0_            0.00 z=CONST0;\n" );
+    Vec_StrPrintStr( vStr, "GATE _const1_            0.00 z=CONST1;\n" );
+    SC_LibForEachCell( p, pCell, i )
+    {
+        float LD[16], PD[16];
+        if ( pCell->n_inputs == 0 || pCell->n_outputs != 1 || pCell->fSkip || pCell->n_inputs > 6 )
+        {
+            if ( getenv("SCL_GENLIB_DUMP") )
+                fprintf( stderr, "skip %s: n_inputs %d n_outputs %d fSkip %d\n", pCell->pName, pCell->n_inputs, pCell->n_outputs, pCell->fSkip );
+            continue;
+        }
+        for ( k = 0; k < pCell->n_inputs; k++ )
+        {
+            if ( !Abc_SclComputeLoadDelayPin( p, pCell, k, Slew, LD + k, PD + k ) )
+                break;
+            if ( PD[k] <= 0 ) PD[k] = 0.01;
+            if ( LD[k] < 0 )  LD[k] = 0;
+        }
+        if ( k < pCell->n_inputs )
+        {
+            if ( getenv("SCL_GENLIB_DUMP") )
+                fprintf( stderr, "skip %s: pin %d has no delay table (pins %d, out vRTimings %d, vTimings[%d] %d)\n", pCell->pName, k,
+                         Vec_PtrSize(&pCell->vPins), Vec_PtrSize(&SC_CellPin(pCell, pCell->n_inputs)->vRTimings), k,
+                         k < Vec_PtrSize(&SC_CellPin(pCell, pCell->n_inputs)->vRTimings) ? Vec_PtrSize(&((SC_Timings *)Vec_PtrEntry(&SC_CellPin(pCell, pCell->n_inputs)->vRTimings, k))->vTimings) : -1 );
+            nSkipped++; continue;
+        }
+        SC_CellForEachPinOut( pCell, pPinOut, j )
+        {
+            assert( strlen(pCell->pName) < 200 );
+            Vec_StrPrintStr( vStr, "GATE " );
+            sprintf( Buffer, "%-16s", pCell->pName );
+            Vec_StrPrintStr( vStr, Buffer );
+            sprintf( Buffer, " %7.2f ", pCell->area );
+            Vec_StrPrintStr( vStr, Buffer );
+            Vec_StrPrintStr( vStr, SC_CellPinName(pCell, j) );
+            Vec_StrPrintStr( vStr, "=" );
+            Vec_StrPrintStr( vStr, SC_CellPinOutFunc(pCell, j-pCell->n_inputs) ? SC_CellPinOutFunc(pCell, j-pCell->n_inputs) : "?" );
+            Vec_StrPrintStr( vStr, ";\n" );
+            SC_CellForEachPinIn( pCell, pPin, k )
+            {
+                Vec_StrPrintStr( vStr, "         PIN " );
+                sprintf( Buffer, "%-4s", pPin->pName );
+                Vec_StrPrintStr( vStr, Buffer );
+                sprintf( Buffer, " UNKNOWN  %.4f  999  %7.3f  %8.4f  %7.3f  %8.4f\n",
+                         SC_CellPinCap(pCell, k), PD[k], LD[k], PD[k], LD[k] );
+                Vec_StrPrintStr( vStr, Buffer );
+            }
+            Count++;
+        }
+    }
+    Vec_StrPrintStr( vStr, "\n.end\n" );
+    Vec_StrPush( vStr, '\0' );
+    if ( nSkipped )
+        printf( "Load-aware GENLIB: %d cell(s) skipped (no usable delay table).\n", nSkipped );
+    if ( pnCellCount )
+        *pnCellCount = Count;
+    return vStr;
+}
