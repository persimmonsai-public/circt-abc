+// special slots (const0/1, buffer, inverter).
+static int s_MioLoadAware = 0;
+void Mio_SetLoadAwareMode( int f ) { s_MioLoadAware = f; }
+int  Mio_IsLoadAwareMode()         { return s_MioLoadAware; }
 Mio_Cell2_t * Mio_CollectRootsNew2( Mio_Library_t * pLib, int nInputs, int * pnGates, int fVerbose )
 {
     Mio_Gate_t * pGate0;
@@ -791,7 +800,7 @@ Mio_Cell2_t * Mio_CollectRootsNew2( Mio_Library_t * pLib, int nInputs, int * pnG
     for ( pCell = ppCells0; pCell < ppCells0 + iCell0; pCell++ )
     {
         // check if the gate with this functionality already exists
-        for ( i = 0; i < iCell; i++ )
+        for ( i = (s_MioLoadAware && pCell->nFanins > 1) ? iCell : 0; i < iCell; i++ )
             if ( ppCells[i].pName && ppCells[i].uTruth == pCell->uTruth )
