+/**Function*************************************************************
+  Synopsis    [Per-node output load estimate for load-aware mapping (P6).]
+  Description [Round 0: flow references x average pin cap + wire cap by
+  fanout count. Later rounds: the input caps of the cells actually chosen
+  for the fanouts in the previous round (cut leaves of every referenced
+  best match), plus the wire cap for that many consumers.]
+***********************************************************************/
+static inline float Nf_ManWireCap( Nf_Man_t * p, int nFans )
+{
+    if ( p->vWireCaps == NULL || nFans <= 0 )
+        return 0;
+    return Vec_FltEntry( p->vWireCaps, Abc_MinInt(nFans, Vec_FltSize(p->vWireCaps)-1) );
+}
+void Nf_ManComputeLoads( Nf_Man_t * p )
+{
+    Gia_Obj_t * pObj; int i, c, k, iVar, fCompl, nUsed = 0;
+    Vec_Int_t * vFans;
+    if ( !p->pPars->fUseLoads )
+        return;
+    vFans = Vec_IntStart( Gia_ManObjNum(p->pGia) );
+    Vec_FltFill( &p->vLoads, Gia_ManObjNum(p->pGia), 0 );
+    if ( p->Iter == 0 )
+    {
+        Gia_ManForEachObj( p->pGia, pObj, i )
+        {
+            float Refs = Vec_FltEntry(&p->vFlowRefs, 2*i) + Vec_FltEntry(&p->vFlowRefs, 2*i+1);
+            int nFans = (int)(Refs + 0.5);
+            Vec_FltWriteEntry( &p->vLoads, i, Refs * p->AvgCapF + Nf_ManWireCap(p, nFans) );
+        }
+    }
+    else
+    {
+        Gia_ManForEachAnd( p->pGia, pObj, i )
+        for ( c = 0; c < 2; c++ )
+        {
+            Nf_Mat_t * pM; Mio_Cell2_t * pCell; int * pCut;
+            if ( !Nf_ObjMapRefNum(p, i, c) )
+                continue;
+            pM = Nf_ObjMatchBest( p, i, c );
+            if ( pM->Gate < 4 || !Nf_ObjHasCuts(p, i) )
+                continue;
+            pCell = Nf_ManCell( p, pM->Gate );
+            pCut  = Nf_CutFromHandle( Nf_ObjCutSet(p, i), pM->CutH );
+            Nf_CutForEachVarCompl( pCut, pM->Cfg, iVar, fCompl, k )
+            {
+                Vec_FltAddToEntry( &p->vLoads, iVar, (float)pCell->iCaps[k] / SCL_NUM );
+                Vec_IntAddToEntry( vFans, iVar, 1 );
+            }
+            nUsed++;
+        }
+        Gia_ManForEachObj( p->pGia, pObj, i )
+        {
+            int nFans = Vec_IntEntry( vFans, i );
+            if ( nFans == 0 ) // node not referenced by the previous mapping: keep the flow estimate
+            {
+                float Refs = Vec_FltEntry(&p->vFlowRefs, 2*i) + Vec_FltEntry(&p->vFlowRefs, 2*i+1);
+                Vec_FltWriteEntry( &p->vLoads, i, Refs * p->AvgCapF + Nf_ManWireCap(p, (int)(Refs + 0.5)) );
+            }
+            else
+                Vec_FltAddToEntry( &p->vLoads, i, Nf_ManWireCap(p, nFans) );
+        }
+    }
+    // clamp: nets beyond the library's characterized load get buffer trees downstream
+    if ( p->pPars->MaxLoadF > 0 )
+        Gia_ManForEachObj( p->pGia, pObj, i )
+            if ( Vec_FltEntry(&p->vLoads, i) > p->pPars->MaxLoadF )
+                Vec_FltWriteEntry( &p->vLoads, i, p->pPars->MaxLoadF );
+    if ( p->pPars->fVerbose )
+    {
+        double Sum = 0; float Max = 0;
+        Gia_ManForEachAnd( p->pGia, pObj, i )
+            Sum += Vec_FltEntry(&p->vLoads, i), Max = Abc_MaxFloat( Max, Vec_FltEntry(&p->vLoads, i) );
+        printf( "Loads (round %d): %d mapped refs, mean %.2f fF, max %.2f fF\n", p->Iter, nUsed, Sum / Abc_MaxInt(1, Gia_ManAndNum(p->pGia)), Max );
+    }
+    Vec_IntFree( vFans );
+}
 void Nf_ManComputeMapping( Nf_Man_t * p )
 {
     Gia_Obj_t * pObj; int i, arrTime;
+    Nf_ManComputeLoads( p );
     if ( p->pManTim )
         Tim_ManIncrementTravId( p->pManTim );    
     Gia_ManForEachObjWithBoxes( p->pGia, pObj, i )
@@ -2031,6 +2141,7 @@ void Nf_ManResetMatches( Nf_Man_t * p, int Round )
 void Nf_ManComputeMappingEla( Nf_Man_t * p )
 {
     int fVerbose = 0;
+    Nf_ManComputeLoads( p );
     Gia_Obj_t * pObj;
     Mio_Cell2_t * pCell;
     Nf_Mat_t Mb, * pMb = &Mb, * pM;
@@ -2706,6 +2817,7 @@ void Nf_ManSetDefaultPars( Jf_Par_t * pPars )
     pPars->nLutSizeMax  =  NF_LEAF_MAX;
     pPars->nCutNumMax   =  NF_CUT_MAX;
     pPars->MapDelayTarget = 0;
+    pPars->MaxLoadF     = 30.0;
 }
