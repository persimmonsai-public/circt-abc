+int Scl_CommandDrcSize( Abc_Frame_t * pAbc, int argc, char ** argv )
+{
+    Abc_Ntk_t * pNtk = Abc_FrameReadNtk(pAbc);
+    float SlewLimit = 0;
+    int c, nIters = 5, fUseWireLoads = 1, fVerbose = 0;
+    Extra_UtilGetoptReset();
+    while ( ( c = Extra_UtilGetopt( argc, argv, "SIcvh" ) ) != EOF )
+    {
+        switch ( c )
+        {
+        case 'S':
+            if ( globalUtilOptind >= argc ) goto usage;
+            SlewLimit = atof(argv[globalUtilOptind]);
+            globalUtilOptind++;
+            break;
+        case 'I':
+            if ( globalUtilOptind >= argc ) goto usage;
+            nIters = atoi(argv[globalUtilOptind]);
+            globalUtilOptind++;
+            break;
+        case 'c':
+            fUseWireLoads ^= 1;
+            break;
+        case 'v':
+            fVerbose ^= 1;
+            break;
+        case 'h':
+        default:
+            goto usage;
+        }
+    }
+    if ( pNtk == NULL || !Abc_NtkHasMapping(pNtk) )
+    {
+        fprintf( pAbc->Err, "There is no current mapped network.\n" );
+        return 1;
+    }
+    if ( pAbc->pLibScl == NULL )
+    {
+        fprintf( pAbc->Err, "There is no Liberty library available.\n" );
+        return 1;
+    }
+    Abc_SclDrcSizePerform( (SC_Lib *)pAbc->pLibScl, pNtk, SlewLimit,
+                           fUseWireLoads, nIters, fVerbose );
+    return 0;
+
+usage:
+    fprintf( pAbc->Err, "usage: drc_size [-S float] [-I num] [-cvh]\n" );
+    fprintf( pAbc->Err, "\t         upsizes gates violating max_out_cap (and a slew limit)\n" );
+    fprintf( pAbc->Err, "\t-S num : slew limit in library time units (0 = cap only) [default = 0]\n" );
+    fprintf( pAbc->Err, "\t-I num : maximum iterations [default = 5]\n" );
+    fprintf( pAbc->Err, "\t-c     : toggle wire loads / placement-aware loads [default = on]\n" );
+    fprintf( pAbc->Err, "\t-v     : verbose\n" );
+    fprintf( pAbc->Err, "\t-h     : help\n" );
+    return 1;
+}
