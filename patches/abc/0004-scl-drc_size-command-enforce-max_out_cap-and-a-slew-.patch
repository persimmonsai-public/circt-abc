+/**CFile****************************************************************
+
+  FileName    [sclDrc.c]
+
+  SystemName  [ABC: Logic synthesis and verification system.]
+
+  PackageName [Standard-cell library representation.]
+
+  Synopsis    [DRC-driven sizing: enforce max_out_cap / max slew.]
+
+  Author      [circt-abc project]
+
+  Affiliation [-]
+
+  Date        [Started 2026-09-02.]
+
+  Revision    []
+
+***********************************************************************/
+
+#include "sclSize.h"
+
+ABC_NAMESPACE_IMPL_START
+
+////////////////////////////////////////////////////////////////////////
+///                        DECLARATIONS                              ///
+////////////////////////////////////////////////////////////////////////
+
+// Neither upsize/dnsize nor buffer ever ENFORCE the library's electrical
+// design rules: a D1 gate can be left driving 20x its max_out_cap and the
+// only trace is a printout. On unrepaired netlists that also destroys the
+// honesty of every timing number downstream: slews leave the NLDM
+// characterization range and both OpenSTA and Scl_LibLookup linearly
+// extrapolate, compounding stage over stage (measured 8-10x delay
+// inflation on a 4nm library). This pass upsizes each gate to the
+// smallest same-function variant whose output max_out_cap covers its
+// actual load (placement-aware when read_place is in effect), and
+// optionally treats a slew limit as a further upsizing pressure.
+
+////////////////////////////////////////////////////////////////////////
+///                     FUNCTION DEFINITIONS                         ///
+////////////////////////////////////////////////////////////////////////
+
+/**Function*************************************************************
+
+  Synopsis    [Enforces max_out_cap (and a slew limit) by upsizing.]
+
+  Description [SlewLimit in library time units (ps in SCL-internal terms);
+  <= 0 disables the slew criterion. Returns the number of gates changed.]
+
+***********************************************************************/
+int Abc_SclDrcSizePerform( SC_Lib * pLib, Abc_Ntk_t * pNtk, float SlewLimit,
+                           int fUseWireLoads, int nIters, int fVerbose )
+{
+    SC_Man * p;
+    Abc_Obj_t * pObj;
+    SC_Cell * pCell, * pBest, * pTemp;
+    SC_Pin * pPinOut;
+    float Load, Slew;
+    int i, k, iter, nChanged, nTotal = 0, nCapViol, nSlewViol;
+    p = Abc_SclManStart( pLib, pNtk, fUseWireLoads, 1, 0, 0 );
+    for ( iter = 0; iter < nIters; iter++ )
+    {
+        nChanged = 0;
+        nCapViol = nSlewViol = 0;
+        Abc_NtkForEachNode1( pNtk, pObj, i )
+        {
+            pCell = Abc_SclObjCell( pObj );
+            if ( pCell == NULL || pCell->n_outputs != 1 )
+                continue;
+            Load = Abc_SclObjLoadMax( p, pObj );
+            Slew = Abc_SclObjSlewMax( p, pObj );
+            pPinOut = SC_CellPin( pCell, pCell->n_inputs );
+            if ( Load <= pPinOut->max_out_cap &&
+                 (SlewLimit <= 0 || Slew <= SlewLimit) )
+                continue;
+            if ( Load > pPinOut->max_out_cap )
+                nCapViol++;
+            else
+                nSlewViol++;
+            // smallest same-function cell whose output pin covers the load;
+            // when only the slew is violated, demand one step more drive
+            // than the current cell provides
+            pBest = NULL;
+            SC_RingForEachCell( pCell->pRepr, pTemp, k )
+            {
+                SC_Pin * pPo = SC_CellPin( pTemp, pTemp->n_inputs );
+                if ( pPo->max_out_cap < Load )
+                    continue;
+                if ( Load <= pPinOut->max_out_cap && pTemp->area <= pCell->area )
+                    continue; // slew-only violation: require a bigger cell
+                pBest = pTemp;
+                break;
+            }
+            if ( pBest == NULL )
+                pBest = pCell->pRepr->pPrev; // largest available
+            if ( pBest == pCell )
+                continue;
+            Abc_SclObjSetCell( pObj, pBest );
+            Abc_SclUpdateLoad( p, pObj, pCell, pBest );
+            nChanged++;
+        }
+        nTotal += nChanged;
+        if ( fVerbose )
+            printf( "drc_size iter %d: %d cap / %d slew violations, "
+                    "%d gates upsized.\n",
+                    iter, nCapViol, nSlewViol, nChanged );
+        if ( nChanged == 0 )
+            break;
+        Abc_SclTimeNtkRecompute( p, NULL, NULL, 0, 0 );
+    }
+    printf( "drc_size: %d gate(s) upsized for electrical DRC "
+            "(max_out_cap%s).\n", nTotal,
+            SlewLimit > 0 ? " + slew limit" : "" );
+    Abc_SclSclGates2MioGates( pLib, pNtk ); // updates gate pointers
+    Abc_SclManFree( p );
+    return nTotal;
+}
+
+////////////////////////////////////////////////////////////////////////
+///                       END OF FILE                                ///
+////////////////////////////////////////////////////////////////////////
+
+ABC_NAMESPACE_IMPL_END
