+/**Function*************************************************************
+
+  Synopsis    [HPWL wire cap over a driver and an explicit fanout set.]
+
+  Description [For the buffering engine: unlike Scl_PlaceNetWireCap this
+  SKIPS fanouts without coordinates (freshly created buffers) instead of
+  refusing the whole net -- the tree under construction still sees the
+  span of the located sinks. Returns -1 when placement is not loaded,
+  the driver is unlocated, or no fanout is located (caller falls back
+  to the wire-load table).]
+
+***********************************************************************/
+float Scl_PlaceFanoutsWireCap( Abc_Ntk_t * pNtk, Abc_Obj_t * pDriver,
+                               Vec_Ptr_t * vFanouts )
+{
+    Abc_Obj_t * pFanout;
+    float x, y, xMin, xMax, yMin, yMax;
+    int i, nLocated = 0;
+    if ( !Scl_PlaceIsRunning(pNtk) )
+        return -1;
+    if ( !Scl_PlaceObjCoord( pNtk, Abc_ObjId(pDriver), &x, &y ) )
+        return -1;
+    xMin = xMax = x;
+    yMin = yMax = y;
+    Vec_PtrForEachEntry( Abc_Obj_t *, vFanouts, pFanout, i )
+    {
+        if ( pFanout == NULL )
+            continue;
+        if ( !Scl_PlaceObjCoord( pNtk, Abc_ObjId(pFanout), &x, &y ) )
+            continue;
+        nLocated++;
+        xMin = Abc_MinFloat( xMin, x );
+        xMax = Abc_MaxFloat( xMax, x );
+        yMin = Abc_MinFloat( yMin, y );
+        yMax = Abc_MaxFloat( yMax, y );
+    }
+    if ( nLocated == 0 )
+        return -1;
+    return s_pSclPlace->CapPerUm * ( (xMax - xMin) + (yMax - yMin) );
+}
+
+/**Function*************************************************************
+
+  Synopsis    [Places an object at the centroid of its located fanouts.]
+
+  Description [For freshly created buffers: gives them a coordinate so
+  later load computations (and further tree levels) see realistic
+  spans. Returns 0 if no fanout had a coordinate.]
+
+***********************************************************************/
+int Scl_PlaceSetCentroidFromFanouts( Abc_Ntk_t * pNtk, Abc_Obj_t * pObj )
+{
+    Abc_Obj_t * pFanout;
+    float x, y, sx = 0, sy = 0;
+    int i, n = 0;
+    if ( !Scl_PlaceIsRunning(pNtk) )
+        return 0;
+    Abc_ObjForEachFanout( pObj, pFanout, i )
+    {
+        if ( !Scl_PlaceObjCoord( pNtk, Abc_ObjId(pFanout), &x, &y ) )
+            continue;
+        sx += x;
+        sy += y;
+        n++;
+    }
+    if ( n == 0 )
+        return 0;
+    Scl_PlaceSetObjCoord( pNtk, Abc_ObjId(pObj), sx / n, sy / n );
+    return 1;
+}
+
