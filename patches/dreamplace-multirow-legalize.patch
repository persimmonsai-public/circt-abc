+    def _legalize_max_displacement(self, params, placedb):
+        """First-pass greedy displacement bound from params
+        legalize_max_displacement_sites (0/absent = upstream unbounded
+        behavior), converted to scaled coordinate units."""
+        sites = int(getattr(params, "legalize_max_displacement_sites", 0) or 0)
+        if sites <= 0:
+            return 0.0
+        bound = sites * placedb.site_width
+        logging.info("greedy legalization first-pass displacement bound: %d sites (%g units)" % (sites, bound))
+        return bound
+
+    def _multirow_parity(self, placedb):
+        """Required bottom-row parity for even-row-height cells, derived from
+        DEF row orientations (place_io's MultiRowAttr convention: even-height
+        cells align to row 0's orientation). Rows may be split into several
+        x-segments sharing one y (the DEF is free to do that), so parity is
+        judged per row INDEX computed from each entry's y coordinate, not
+        from list order. Returns 0 when orientation is a strict function of
+        row-index parity, else -1 (unconstrained, with a warning)."""
+        orients = getattr(placedb, "row_orients", None)
+        rows = getattr(placedb, "rows", None)
+        if orients is None or rows is None or len(orients) < 2 or \
+                len(orients) != len(rows):
+            return -1
+        import numpy as np
+        ylv = rows[:, 1]
+        idx = np.rint((ylv - ylv.min()) / placedb.row_height).astype(int)
+        o_even = np.unique(orients[idx % 2 == 0])
+        o_odd = np.unique(orients[idx % 2 == 1])
+        if len(o_even) == 1 and len(o_odd) == 1 and o_even[0] != o_odd[0]:
+            return 0
+        logging.warning(
+            "row orientation is not a function of row parity; multi-row "
+            "cells legalize without parity constraint (even=%s odd=%s)" %
+            (o_even.tolist(), o_odd.tolist()))
+        return -1
+
